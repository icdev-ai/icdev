# ============================================================================
# ICDEV LOCAL CANVAS COPY — per-person .env (lpx-keys-04)
# ============================================================================
#
# This template is for a LOCAL CANVAS COPY that one person runs on their laptop.
# It deliberately makes the wrong thing hard: there is NO real-provider-key slot.
#
# A local copy authenticates to the SHARED, hosted LLM gateway with a PER-PERSON
# virtual key. The real provider key lives ONLY on the gateway, server-side, and
# is never distributed into local .env files — so it can be revoked for one
# person without rotating it for everyone, and rotating it never breaks every
# copy at once.
#
# DO NOT paste a real ANTHROPIC_API_KEY / OPENAI_API_KEY here. If a call fails
# because the gateway is unreachable, the copy fails CLOSED with a clear message
# (it will NOT fall back to a real key). Fix the gateway URL or your virtual key
# — never add a real provider key to a laptop.
# ----------------------------------------------------------------------------

PYTHONPATH=.

# Mark this install as a per-person local copy. This forces all cloud LLM traffic
# through the gateway and makes missing-virtual-key a FAIL-CLOSED error.
ICDEV_LLM_LOCAL_COPY=true

# The hosted gateway this copy talks to (ask your cohort lead / facilitator).
ICDEV_LLM_PROXY_ENABLED=true
ICDEV_LLM_PROXY_BASE_URL=https://gateway.example.internal:4000

# Your PERSONAL virtual key. Issued for you with:
#   python tools/llm/proxy_keys.py issue --scope-type user --scope-ref <you> --json
# Revocable for you alone; never a real provider key.
ICDEV_LLM_PROXY_VIRTUAL_KEY=

# --- Intentionally ABSENT: no real provider key slots. ---
# (No ANTHROPIC_API_KEY, OPENAI_API_KEY, AWS_SECRET_ACCESS_KEY, or
#  LITELLM_MASTER_KEY on a laptop. Those belong only on the gateway host.)
