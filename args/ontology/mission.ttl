@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix core: <https://icdev.dev/ns/core#> .
@prefix mission: <https://icdev.dev/ns/mission#> .

<https://icdev.dev/ontology/mission>
    rdf:type owl:Ontology ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "ICDEV MISSION Domain Ontology" ;
    dcterms:description "Class hierarchy for the mission canvas domain." ;
    dcterms:date "2026-05-15"^^xsd:date .

mission:Zone rdf:type owl:Class ;
    rdfs:label "Mission Zone" ;
    rdfs:subClassOf core:Resource .

mission:Zone.Situation rdf:type owl:Class ;
    rdfs:label "Situation Zone" ;
    rdfs:subClassOf mission:Zone .

mission:Zone.Intelligence rdf:type owl:Class ;
    rdfs:label "Intelligence Zone" ;
    rdfs:subClassOf mission:Zone .

mission:Zone.Execution rdf:type owl:Class ;
    rdfs:label "Execution Zone" ;
    rdfs:subClassOf mission:Zone .

mission:Zone.Security rdf:type owl:Class ;
    rdfs:label "Security Zone" ;
    rdfs:subClassOf mission:Zone .

mission:Status rdf:type owl:Class ;
    rdfs:label "Mission Status" ;
    rdfs:subClassOf core:Concept .
