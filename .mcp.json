{
  "servers": {
    "icdev-unified": {
      "command": "python",
      "args": [
        "tools/mcp/unified_server.py"
      ],
      "env": {
        "ICDEV_DB_PATH": "data/icdev.db",
        "ICDEV_PROJECT_ROOT": "."
      }
    },
    "playwright": {
      "command": "npx",
        "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
