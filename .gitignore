# Environment variables
.env
.env.local

# Claude Code local settings (may contain credentials in allow rules)
.claude/settings.local.json

# Databases (regeneratable)
data/*.db
data/*.db.bak*
data/tenants/*.db
*.sqlite
*.sqlite3

# Database backups (generated by tools/db/backup.py)
data/backups/

# Temporary files
.tmp/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
**/*.pyc
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Agent output directories
agents/
# Exception: FathomDesk analyst agent source is tracked
!tools/fathomdesk/agents/

# Claude Code output
claude-max-output.json
claude-max-output.jsonl

# Temp debug files
_pdb_b64_*.txt

# Playwright output (screenshots, console logs, videos, traces)
playwright/
.playwright-mcp/

# Screenshots (root-level)
*.png
*.jpg
*.jpeg
*.gif

# Generated reports and planning tasks
reports/
tasks/

# Test suite (local only)
tests/

# Vendored binaries (downloaded via setup, not committed)
# Use layered rules so vendor/drivers README + .gitkeep + CHECKSUMS manifest
# can be tracked while actual binary executables (.exe, bare binaries) are not.
vendor/*
!vendor/drivers/
vendor/drivers/*
!vendor/drivers/README.md
!vendor/drivers/CHECKSUMS.md
!vendor/drivers/msedgedriver/
vendor/drivers/msedgedriver/*
!vendor/drivers/msedgedriver/.gitkeep
!vendor/drivers/chromedriver/
vendor/drivers/chromedriver/*
!vendor/drivers/chromedriver/.gitkeep
# But keep dashboard static vendor (JS/CSS libs for air-gap)
!tools/dashboard/static/vendor/

# Generated projects (created by project_create.py)
# projects/  # Uncomment to ignore generated projects
videos/

# Build artifacts (child apps)
intaas-saas/.build/
intaas-saas/.build-*.zip
marketplace-saas/.aws-sam/
marketplace-saas/.pytest_cache/

# Hypothesis (property-based testing cache)
.hypothesis/

# Claude Code project settings (local only)
.claude/projects/

# Private keys (NEVER commit)
*.private_key.pem
args/marketplace_private_key.pem

# Genesis runtime exports (GKP artifacts)
data/genesis/exports/

# Pulse runtime data
data/pulse/
data/pulse_content/

# Runtime data files
data/installed_assets.json
data/license_tokens.json

# Local ICDEV databases (icdev package)
icdev/data/*.db

# PostgreSQL data directory (Docker bind mount)
data/pgdata/

# Marketplace modules and child apps (synced to D:\ICDEV_BACKUP)
marketplace-saas/
intaas-frontend/
intaas-saas/

# FathomDesk — Marketplace module, not part of ICDEV core
apps/fathomdesk/
tools/trading/
args/trading_config.yaml
args/trading_daemon_config.yaml
args/llm_config_trading.yaml
data/fathomdesk.db
data/fathomdesk.db-shm
data/fathomdesk.db-wal
data/network_canvas.db-shm
data/network_canvas.db-wal

# Frontend build artifacts
frontend/.next/
frontend/out/
frontend/node_modules/
