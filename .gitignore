data/pgdata/

# Marketplace modules and child apps (synced to D:\ICDEV_BACKUP)
marketplace-saas/
intaas-frontend/
intaas-saas/

# FathomDesk — Marketplace module, not part of ICDEV core
apps/fathomdesk/
tools/trading/
args/trading_config.yaml
args/trading_daemon_config.yaml
args/llm_config_trading.yaml
data/fathomdesk.db
data/fathomdesk.db-shm
data/fathomdesk.db-wal
data/network_canvas.db-shm
data/network_canvas.db-wal

# Frontend build artifacts
frontend/.next/
frontend/out/
frontend/node_modules/
.logs/

# oss-redteam-02: authorization records + finding triage are operational, never source
data/redteam/
# Live BOM plan config — names real people, real committed dates, a real task
# list. ICDEV is public. Ship args/bom_plan.example.yaml; keep the real one out.
args/bom_plan.yaml

# Per-session daily memory logs. CLAUDE.md's session protocol reads these, but
# they are local working notes — zero have ever been tracked, and they land as
# untracked noise in every `git status`, which is how scratch files get swept
# into an auto-commit.
memory/logs/

# Hermes' private plan/scratch directory. Never tracked; tool-local state.
.hermes/
