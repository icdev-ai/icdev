# Environment variables
.env
.env.local

# Claude Code local settings (may contain credentials in allow rules)
.claude/settings.local.json

# Databases (regeneratable)
data/*.db
data/*.db.bak*
data/tenants/*.db
# WAL sidecars: any test run in WAL mode drops these next to the .db. They were
# only ignored per-database (fathomdesk, network_canvas), so running the suite
# left data/icdev.db-shm / -wal untracked -- and the auto-commit hook sweeps
# untracked files into a commit and pushes them.
data/*.db-shm
data/*.db-wal
data/tenants/*.db-shm
data/tenants/*.db-wal
*.sqlite
*.sqlite3

# Database backups (generated by tools/db/backup.py)
data/backups/
# Router circuit-breaker state — machine-specific runtime data, written by
# LLMRouter. Never commit: it would pin one machine's provider failures
# onto everyone else's checkout.
data/llm_embedding_unavailable.json
data/llm_degraded_tier2.json

# Canvas run output — written by the *_generator / *_scanner tools on every run
# (IaC bundles, iac_report_<hash>.md, compliance_report_<hash>.md, deploy_<hash>/).
#
# Untracked, and indistinguishable from intentional content, these were swept
# into unrelated commits by `git add -A` and by the auto-commit hook: 73 had
# already been committed that way, in the same hash-suffixed shape the tools
# still emit. They are pure runtime output — nothing reads the committed copies,
# and the DWO tests that mention these paths use them only as fixture STRINGS.
#
# Untracked in the same commit that added this rule; the files stay on disk and
# remain recoverable from history. Enforced by
# tests/test_generated_artifacts_untracked.py.
data/studio_artifacts/

# Generated ATO packages (rmf-inert-01). Each is a point-in-time ZIP over
# board data — reproducible from the board with `python -m
# tools.compliance.ato_packager`, and a package committed to a public repo is
# a system's control posture published.
data/ato_packages/

# floci AWS-emulator persistent state (flx-compose-01). FLOCI_STORAGE_MODE
# =persistent makes the emulator write its buckets, queues, tables and Lambda
# bundles under ./data/floci — per-machine runtime state that would otherwise be
# committed to this PUBLIC repo. Anchored to `data/floci/` and NOT a bare
# unanchored `data/`: that pattern once silently dropped a code directory here.
data/floci/

# floci-az AZURE-emulator persistent state (flx-az-01). A SEPARATE entry, and
# it has to be: the rule above ends in a slash, so `data/floci/` matches the
# directory `floci` and NOT `floci-az`. Without this line the Azure emulator's
# blobs, queues, tables and ARM resources land in this PUBLIC repo.
# FLOCI_AZ_STORAGE_MODE=persistent writes under ./data/floci-az (the image's
# own /app/data, not /var/lib/floci — the two emulators differ).
data/floci-az/

# floci-gcp GCP-emulator persistent state (flx-gcp-01). A THIRD entry, for the
# same reason the second one was needed: every rule here ends in a slash and so
# matches exactly one directory name. Without this line the GCP emulator's
# buckets, Pub/Sub topics, secrets, key rings and BigQuery datasets land in this
# PUBLIC repo. FLOCI_GCP_STORAGE_MODE=persistent writes under ./data/floci-gcp
# (the image's own /app/data — the same target as floci-az, a different
# directory from floci).
data/floci-gcp/

# Alert spool and failed-audit dead-letter file — per-machine runtime state.
data/alerts/
data/failed_audit_entries.jsonl

# Temporary files
.tmp/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
**/*.pyc
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Build artifacts (generated by pip install / python setup.py build)
build/
dist/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
# Anchored to the repo root. A bare `logs/` matches ANY directory named logs at any
# depth, which silently swallowed source directories belonging to the /logs canvas:
# context/iqe/queries/logs/, icdev/tools/dashboard/templates/logs/, and
# tools/dashboard/templates/logs/ (that one was force-added; its icdev mirror and
# IQE seed queries were not, which is why the canvas failed the completeness gate).
/logs/

# Agent output directories
agents/
# Exception: FathomDesk analyst agent source is tracked
!tools/fathomdesk/agents/
# Exception: dashboard template sub-directories named agents/ are source code
!tools/dashboard/templates/agents/
!icdev/tools/dashboard/templates/agents/
# Exception: tools/agents/ is the agent adapter REGISTRY — real source code, not
# agent output. The bare `agents/` rule above silently untracked all 9 files, so
# they existed only on the machine that wrote them: absent from every fresh
# clone, every CI checkout, and therefore from every published wheel. Same class
# of failure as the /logs/ one documented above.
!tools/agents/
!icdev/tools/agents/

# Claude Code output
claude-max-output.json
claude-max-output.jsonl

# Temp debug files
_pdb_b64_*.txt

# Security — session cookies / credentials
cookies.txt
*.cookie
*.cookies

# Python coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Pip install artifacts (e.g. "=6.0" from pip output redirect)
=*

# Mystery / garbage files
None
u2715

# Scratch text exports (coherence, ng, pa outputs)
coherence_out.txt
_ng_src.txt
_pa_src.txt
_*.txt

# Generated output / health probes
err.txt
health_prober_output.txt
verification_result.txt
telegram_out.log
telegram_stderr.log

# SQLite databases dumped to root (should live under data/)
network_canvas

# One-off test JS
_aadc_test.js

# Root-level standalone scripts (moved to scripts/)
signal_generator.py

# Playwright output (screenshots, console logs, videos, traces)
playwright/
.playwright-mcp/

# Screenshots (root-level)
*.png
*.jpg
*.jpeg
*.gif

# Generated reports
reports/

# Test suite — track unit tests and E2E specs; exclude generated/cache dirs
tests/__pycache__/
tests/*/__pycache__/
tests/.pytest_cache/
tests/genesis_auto/__pycache__/
tests/genesis_auto/*.pyc

# Vendored binaries (downloaded via setup, not committed)
# Use layered rules so vendor/drivers README + .gitkeep + CHECKSUMS manifest
# can be tracked while actual binary executables (.exe, bare binaries) are not.
vendor/*
!vendor/drivers/
vendor/drivers/*
!vendor/drivers/README.md
!vendor/drivers/CHECKSUMS.md
!vendor/drivers/msedgedriver/
vendor/drivers/msedgedriver/*
!vendor/drivers/msedgedriver/.gitkeep
!vendor/drivers/chromedriver/
vendor/drivers/chromedriver/*
!vendor/drivers/chromedriver/.gitkeep
# Image bundles (flx-airgap-01): the PIN and the README are evidence and are
# tracked; the .tar bundles are hundreds of MB and travel on transport media.
!vendor/images/
vendor/images/*
!vendor/images/README.md
!vendor/images/images-*.txt
# But keep dashboard static vendor (JS/CSS libs for air-gap)
!tools/dashboard/static/vendor/

# Generated projects (created by project_create.py)
# projects/  # Uncomment to ignore generated projects
videos/

# Build artifacts (child apps)
intaas-saas/.build/
intaas-saas/.build-*.zip
marketplace-saas/.aws-sam/
marketplace-saas/.pytest_cache/

# Hypothesis (property-based testing cache)
.hypothesis/

# Claude Code project settings (local only)
.claude/projects/

