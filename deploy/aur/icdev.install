# pacman install hooks for the `icdev` AUR package (omx-dist-01).
# ICDEV lives in its own venv at /opt/icdev; /usr/bin/icdev* are symlinks into it.

post_install() {
  echo ">>> ICDEV is installed in /opt/icdev."
  echo ">>> Finish the host setup (PostgreSQL, .env, MCP, skills, guards) as YOUR user:"
  echo ">>>   icdev omarchy setup --dry-run    # see the plan"
  echo ">>>   icdev omarchy setup --yes"
  echo ">>> .env goes to \$ICDEV_PROJECT_ROOT, else the 'icdev init' project you run it from,"
  echo ">>> else ~/.config/icdev -- never into /opt/icdev, which root owns."
  echo ">>> The genesis supervisor (systemd timer, --start) needs a source checkout: it writes"
  echo ">>> its pid lock, logs and data under its own root. From a git clone of icdev, run"
  echo ">>> 'python -m tools.cli omarchy setup --yes --start'."
}

post_upgrade() {
  echo ">>> ICDEV upgraded. Re-run 'icdev omarchy setup' to apply new setup steps (idempotent)."
}

post_remove() {
  echo ">>> /opt/icdev removed. Host state is untouched; 'icdev omarchy uninstall' reverses it"
  echo ">>> (run it BEFORE removing the package next time). Your database and .env are kept."
}
