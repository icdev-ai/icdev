# Maintainer: Sovanna Chuon
#
# GENERATED by tools/installer/release.py -- do not hand-edit pkgver or
# sha256sums. Re-render from the release wheel instead:
#   python tools/installer/release.py --aur-from-wheel dist/icdev-<ver>-py3-none-any.whl
#
# Arch's python is PEP 668 externally-managed, so ICDEV is installed into its
# own venv under /opt/icdev -- never into the system site-packages. pip fetches
# the wheel's Python dependencies from PyPI inside package().

pkgname=icdev
pkgver=1.2.43
pkgrel=1
pkgdesc="ICDEV - AI-powered SDLC with NIST 800-53 RMF compliance and multi-agent orchestration"
arch=('x86_64' 'aarch64')
url="https://icdev.ai/"
license=('Apache-2.0')
depends=('python' 'git')
optdepends=('postgresql: primary storage backend (SQLite is the fallback)'
            'pgvector: vector search on PostgreSQL'
            'opencode: default agent harness on Omarchy'
            'ollama: local LLM inference'
            'ghidra: decompiler for tools/analyzers/ghidra_headless (Ghidra 12 + PyGhidra)')
options=('!strip' '!debug')
install=icdev.install
_whl="${pkgname}-${pkgver}-py3-none-any.whl"
source=("${_whl}::https://files.pythonhosted.org/packages/py3/i/${pkgname}/${_whl}")
noextract=("${_whl}")
sha256sums=('1388d4c0be3f3a46ac20c4801b33dfcb0493beb8c321cd7fbda12b1b43a566c9')

package() {
  local _venv="${pkgdir}/opt/${pkgname}"
  python -m venv "${_venv}"
  "${_venv}/bin/python" -m pip install --no-cache-dir --no-compile \
    --disable-pip-version-check "${srcdir}/${_whl}[postgresql]"

  # venv scripts (shebangs) and pyvenv.cfg (`command =`) record the build-time
  # path; point them at /opt. makepkg warns "reference to $pkgdir" otherwise.
  grep -rlI --null "${pkgdir}" "${_venv}/bin" "${_venv}/pyvenv.cfg" | xargs -0 -r sed -i "s|${pkgdir}||g"
  "${_venv}/bin/python" -m compileall -q -s "${pkgdir}" -p / "${_venv}/lib"

  install -dm755 "${pkgdir}/usr/bin"
  local _ep
  for _ep in icdev icdev-dashboard icdev-enable icdev-init icdev-init-db icdev-mcp icdev-mcp-builder icdev-mcp-compliance icdev-mcp-core icdev-mcp-knowledge icdev-mcp-maintenance; do
    ln -s "/opt/${pkgname}/bin/${_ep}" "${pkgdir}/usr/bin/${_ep}"
  done
}
