# collection: ccc.circuits
# query: high utilization circuits near capacity
# description: Circuits at ≥70% utilization that need capacity planning attention
# tags: [capacity, utilization, planning]
# The IQE below is what the ccc adapter answers this prompt with (tools/iqe/adapters/ccc.py).
foreach c in ccc.circuits
where c.utilization_pct >= 70
select c.circuit_id, c.carrier, c.bandwidth_gbps, c.utilization_pct, c.status
# Presentation (IQE has no `order by`; the reader applies it): sort by c.utilization_pct desc.
