# MCIP DAT seed query (split from mcip.iqe). Collection: dat.dti_history.
# Prompt: show recent dti scores ordered by computed_at
foreach h in dat.dti_history
select h.id, h.score, h.cable_sub, h.unsc_sub, h.backchannel_sub, h.event_count, h.computed_at
# Not applied: IQE has no `order by`, so the executor returns every matching row, unsorted and uncapped. Intended presentation, not performed: sort by h.computed_at desc.
