# IQE-MC-005: AI migration readiness assessments (MC)
# Filters to readiness_assessment decisions capturing grade, score,
# and workload readiness — evidence for DoD C2C migration gate reviews.

foreach d in mc.ai_decisions
where d.decision_type == "readiness_assessment"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
