# IQE-AADC-005: AI risk score decisions from the Agentic AI Design Canvas
# Filters to risk_score decisions — maps to DoD RAI "Traceable" principle
# and NIST AI RMF GOVERN 1.1 accountability requirements.

foreach d in aadc.ai_decisions
where d.decision_type == "risk_score"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
