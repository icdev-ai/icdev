# Full ATO readiness per design: ATO report and scorecard health side by side.
# Was a three-way `join ... on` (designs, aadc.ato_reports, aadc.scorecard_snapshots,
# each on design_id == d.id); IQE has no `join ... on` clause, so aadc.ato_readiness is
# that inner join itself.
foreach r in aadc.ato_readiness
  select r.design_name, r.design_domain, r.ato_ready, r.score_pct, r.passed, r.failed, r.critical_failed, r.overall_score, r.health
