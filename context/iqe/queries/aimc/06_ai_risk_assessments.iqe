# IQE-AIMC-006: AI model risk assessment decisions (AIMC)
# Filters to risk_score and compliance_finding decisions for model-level
# risk management evidence per EO 14110, OMB M-25-21, and NIST AI RMF.

foreach d in aimc.ai_decisions
where d.decision_type == "risk_score"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
