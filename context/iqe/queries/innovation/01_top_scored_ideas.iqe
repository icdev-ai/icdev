// IQE-INNOV-001: Top scored ideas in the pipeline — ideas with score > 0 ordered by score
foreach i in innovation.ideas
where i.score_total > 0
select i.id, i.title, i.status, i.phase_tag, i.score_total, i.submitter_role, i.department
# Presentation (IQE has no `order by` or `limit`; the reader applies it): sort by i.score_total desc, keep the first 20 rows.
