# Network Diagram Analysis seed queries for IQE. Collections: network.diagram_uploads,
# network.diagram_analyses, network.diagram_findings (tools/iqe/adapters/ndc.py).
# The parser reads exactly ONE query per file and /iqe/run runs one, so this file
# holds the first and diagram_analysis_02..10_*.iqe hold the others.
# Prompt: show all diagram uploads
foreach u in network.diagram_uploads
select u.id, u.filename, u.format, u.page_count, u.topology_id, u.uploaded_at
