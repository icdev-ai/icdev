# IQE-NDC-012: AI compliance findings from the Network Design Canvas
# Filters to compliance_finding decision type only — maps directly to
# NIST SI-4 continuous monitoring requirements.

foreach d in network.ai_decisions
where d.decision_type == "compliance_finding"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
