# Network Diagram Analysis seed query (split from diagram_analysis.iqe).
# Prompt: show diagram findings for IL4 compliance gaps
# f.tab is one of DIAGRAM_ANALYSIS_FINDING_CATEGORIES (tools/network/constants.py).
foreach f in network.diagram_findings
where f.tab == "compliance"
where f.title contains "IL4" or f.detail contains "IL4"
select f.id, f.analysis_id, f.tab, f.severity, f.title, f.remediation, f.industry, f.topology_mode
