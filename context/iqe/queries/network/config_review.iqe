# Network Configuration Review seed queries for IQE.
# Collections: network.config_reviews, network.config_review_findings (tools/iqe/adapters/ndc.py).
# The parser reads exactly ONE query per file and /iqe/run runs one, so this file
# holds the first and config_review_02..03_*.iqe hold the others.
# Prompt: show config reviews created today
foreach r in network.config_reviews
select r.id, r.title, r.vendor, r.role_key, r.status, r.created_at
# Window NOT applied: IQE has no relative dates, so this query returns every config review, not only those created today.
