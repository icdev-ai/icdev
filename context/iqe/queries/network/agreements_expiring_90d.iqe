# collection: network.agreements_expiring
# query: peering agreements expiring 90 days
# description: Operational peering agreements with contract end within 90 days — renewal risk list
# tags: [agreements, renewal, expiring, risk]
# The 90-day window and the operational filter are the collection's own
# (tools/iqe/adapters/ndc.py), so the query needs no where clause.
foreach a in network.agreements_expiring
select a.id, a.peer_name, a.peer_asn, a.status, a.contract_end, a.days_remaining, a.monthly_cost_usd
# Not applied: IQE has no `order by`, so the executor returns every matching row, unsorted and uncapped. Intended presentation, not performed: sort by a.contract_end asc.
