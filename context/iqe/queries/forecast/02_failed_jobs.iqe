# IQE-FC-002: Failed forecast jobs
# Surfaces jobs that failed inference or loading so operators can investigate.

foreach j in forecast.jobs
where j.status == "failed"
select j.id, j.context, j.model_id, j.error_message, j.created_at
# Presentation (IQE has no `order by` or `limit`; the reader applies it): sort by j.created_at desc, keep the first 50 rows.
