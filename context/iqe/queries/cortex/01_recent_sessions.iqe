# IQE-CORTEX-01: Recent Cortex canvas sessions
# Chat/agent launches across all modes and domain lenses. The adapter already
# returns rows most-recent-first (ORDER BY created_at DESC), so the IQE grammar
# (foreach / where / select — no orderby clause) needs only projection here.

foreach s in cortex.chat_sessions
select s.session_id, s.mode, s.domain, s.status, s.user_id, s.created_at
