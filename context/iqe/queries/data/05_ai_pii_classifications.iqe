# IQE-DDC-005: AI PII/PHI classification decisions (DDC)
# Filters to classification decisions — critical for Privacy Act,
# HIPAA, and FedRAMP data handling compliance evidence.

foreach d in data.ai_decisions
where d.decision_type == "classification"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.created_at
