# IQE-PDC-005: AI compliance findings from the Pipeline Design Canvas
# Filters to compliance_finding decisions — critical for CI/CD gate audits
# and FedRAMP SA-11 (Developer Security Testing) traceability.

foreach d in pipeline.ai_decisions
where d.decision_type == "compliance_finding"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
