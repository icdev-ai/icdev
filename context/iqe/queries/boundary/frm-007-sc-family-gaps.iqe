# CUI // SP-CTI
# IQE Query: FRM-007
# Title: FedRAMP Moderate — System & Communications Protection (SC) Family Gaps
# Framework: FedRAMP Moderate
# Category: control-family
# Severity: high
# Description: SC-family controls cover encryption, network boundary protection,
#   and TLS enforcement. Non-satisfaction in the SC family is a blocking
#   finding for FedRAMP Moderate authorization.

# Written in the retired cATO regex engine's dialect (framework('X').controls,
# starts_with, is null); bdt-iqe-1 moved that surface to compliance.twin_snapshots,
# startswith and == null (tools/genesis/reflexes/cato_twin.py), so this is the same query.
foreach ctrl in compliance.twin_snapshots('FedRAMP Moderate')
where ctrl.control_id startswith 'SC' and ctrl.status != 'satisfied'
select ctrl.control_id, ctrl.implementation_status, ctrl.score, ctrl.project_id
