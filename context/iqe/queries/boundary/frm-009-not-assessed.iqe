# CUI // SP-CTI
# IQE Query: FRM-009
# Title: FedRAMP Moderate — Unassessed Controls
# Framework: FedRAMP Moderate
# Category: coverage
# Severity: moderate
# Description: Controls that have never been assessed represent blind spots in
#   the compliance programme. Continuous monitoring requires 100% assessment
#   coverage; these controls should be scheduled immediately.

# Written in the retired cATO regex engine's dialect (framework('X').controls,
# starts_with, is null); bdt-iqe-1 moved that surface to compliance.twin_snapshots,
# startswith and == null (tools/genesis/reflexes/cato_twin.py), so this is the same query.
foreach ctrl in compliance.twin_snapshots('FedRAMP Moderate')
where ctrl.status == 'not_assessed'
select ctrl.control_id, ctrl.project_id
