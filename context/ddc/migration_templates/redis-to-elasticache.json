{
  "template_id": "ddc-tpl-redis-elasticache",
  "name": "Redis → ElastiCache Migration",
  "description": "Data lineage template: Redis DUMP/RESTORE + connection string cutover + semantic caching layer",
  "source_tech": "redis",
  "target_tech": "elasticache",
  "migration_tool": "dump_restore",
  "nodes": [
    {
      "node_id": "src-redis",
      "label": "Redis 7 (K8s)",
      "node_type": "source",
      "tech": "redis",
      "properties": {"version": "7.2", "memory_gb": 8, "platform": "kubernetes"}
    },
    {
      "node_id": "transform-dump",
      "label": "Redis DUMP Export",
      "node_type": "transform",
      "tech": "redis-cli",
      "properties": {"method": "DUMP/RESTORE", "key_filter": "*", "ttl_preserved": true}
    },
    {
      "node_id": "tgt-elasticache",
      "label": "ElastiCache for Redis",
      "node_type": "target",
      "tech": "elasticache",
      "properties": {"engine_version": "7.1", "node_type": "cache.r7g.large", "multi_az": true, "cluster_mode": false}
    },
    {
      "node_id": "tgt-semantic-cache",
      "label": "Semantic Cache Layer",
      "node_type": "target",
      "tech": "semantic-cache",
      "properties": {"embedding_model": "bedrock-titan-embed", "similarity_threshold": 0.92, "ttl_seconds": 3600}
    }
  ],
  "edges": [
    {"source": "src-redis", "target": "transform-dump", "edge_type": "export", "label": "DUMP keys to migration host"},
    {"source": "transform-dump", "target": "tgt-elasticache", "edge_type": "restore", "label": "RESTORE to ElastiCache"},
    {"source": "tgt-elasticache", "target": "tgt-semantic-cache", "edge_type": "extension", "label": "semantic caching overlay"}
  ],
  "sop_hints": ["dump/restore", "semantic cache", "elasticache semantic"]
}
