{
  "blueprint_id": "bp-aiops-cmd-center",
  "blueprint_version": "1.0.0",
  "app_name": "aiops-command-center",
  "display_name": "AIOps Command Center",
  "description": "GovCloud-certified AIOps dashboard for DoD/IC SOC teams. Self-hosted monitoring, alert correlation, SLO management, automated incident response, and self-healing with NIST 800-53 AU/SI controls built-in.",
  "classification": "CUI // SP-CTI",
  "impact_level": "IL4",
  "target_audience": "DoD SOC teams, IC operations centers, FedRAMP-authorized environments",
  "air_gap_compatible": true,

  "capabilities": {
    "core": {"enabled": true, "always_on": true},
    "compliance": {"enabled": true, "always_on": false, "condition": "ato_required"},
    "security": {"enabled": true, "always_on": true},
    "dashboard": {"enabled": true, "always_on": true},
    "testing": {"enabled": true, "always_on": true},
    "knowledge": {"enabled": true, "always_on": true},
    "monitoring": {"enabled": true, "always_on": true},
    "sre": {"enabled": true, "always_on": true},
    "observability": {"enabled": true, "always_on": true}
  },

  "modules_included": [
    "tools/monitor/health_checker.py",
    "tools/monitor/metric_collector.py",
    "tools/monitor/log_analyzer.py",
    "tools/monitor/alert_correlator.py",
    "tools/monitor/heartbeat_daemon.py",
    "tools/monitor/auto_resolver.py",
    "tools/sre/slo_manager.py",
    "tools/sre/runbook_executor.py",
    "tools/sre/incident_commander.py",
    "tools/llm/gateway.py",
    "tools/llm/model_monitor.py",
    "tools/llm/cost_intelligence.py",
    "tools/agent/topology.py",
    "tools/observability/tracer.py",
    "tools/observability/sqlite_tracer.py",
    "tools/observability/trace_context.py",
    "tools/observability/genai_attributes.py",
    "tools/observability/provenance/prov_recorder.py"
  ],

  "modules_excluded": [
    "tools/govcon",
    "tools/saas",
    "tools/creative",
    "tools/innovation",
    "tools/research",
    "tools/marketplace",
    "tools/translation",
    "tools/pulse",
    "tools/proposal_genesis",
    "tools/genesis",
    "tools/finetune",
    "tools/rag",
    "tools/autoresearch"
  ],

  "dashboard_pages": [
    {
      "route": "/ops",
      "name": "Operations Overview",
      "description": "Real-time service health, SLO burn rates, active incidents"
    },
    {
      "route": "/ops/slos",
      "name": "SLO Dashboard",
      "description": "SLO tracking with error budgets, burn rate charts"
    },
    {
      "route": "/ops/incidents",
      "name": "Incident Commander",
      "description": "Active incidents, severity breakdown, MTTR stats"
    },
    {
      "route": "/ops/alerts",
      "name": "Alert Correlation",
      "description": "Alert grouping, noise reduction, root cause dedup"
    },
    {
      "route": "/ops/runbooks",
      "name": "Runbook Library",
      "description": "Automated runbooks, execution history, success rates"
    },
    {
      "route": "/ops/topology",
      "name": "Service Topology",
      "description": "Agent/model dependency graph, single points of failure"
    },
    {
      "route": "/ops/costs",
      "name": "Cost Intelligence",
      "description": "LLM cost tracking, anomaly detection, optimization recommendations"
    },
    {
      "route": "/ops/self-healing",
      "name": "Self-Healing",
      "description": "Auto-resolution log, confidence scores, PR tracking"
    }
  ],

  "database_tables": [
    "sre_slos",
    "sre_slo_measurements",
    "sre_runbooks",
    "sre_runbook_executions",
    "sre_incidents",
    "sre_incident_events",
    "auto_resolution_log",
    "llm_gateway_audit",
    "llm_cost_alerts",
    "llm_cost_recommendations",
    "model_quality_scores",
    "model_drift_events",
    "agent_topology_snapshots",
    "agent_token_usage",
    "agent_token_budgets",
    "otel_spans"
  ],

  "compliance_frameworks": [
    "NIST_800_53_AU",
    "NIST_800_53_SI",
    "NIST_800_53_IR",
    "FedRAMP_Moderate",
    "CMMC_Level_2"
  ],

  "nist_controls_mapped": {
    "AU-2": "Audit event logging via append-only tables",
    "AU-3": "Audit record content with timestamps and actor IDs",
    "AU-6": "Alert correlation and automated review",
    "AU-12": "Audit generation on all monitored events",
    "SI-4": "Continuous monitoring via heartbeat daemon",
    "SI-5": "Security alert correlation and notification",
    "IR-4": "Incident handling lifecycle automation",
    "IR-5": "Incident monitoring and MTTR tracking",
    "IR-6": "Incident reporting via postmortem generation"
  },

  "deployment": {
    "cloud_modes": ["on_prem", "air_gapped", "government", "commercial"],
    "container": {
      "base_image": "python:3.12-slim",
      "non_root": true,
      "read_only_rootfs": true
    },
    "ports": {
      "dashboard": 8460,
      "api": 8461
    },
    "llm_requirement": "Ollama (local) — zero cloud LLM dependency",
    "database": "SQLite (embedded, no external DB required)"
  },

  "fitness_overrides": {
    "compliance_sensitivity": 8,
    "data_sensitivity": 7,
    "user_interaction": 9,
    "automation_level": 9,
    "scale_requirement": 6,
    "overall_score": 8
  },

  "user_decisions": {
    "ato_required": true,
    "security_required": true,
    "mbse_enabled": false,
    "dashboard_enabled": true,
    "monitoring_enabled": true,
    "sre_enabled": true
  },

  "created_at": "2026-03-20T21:45:00Z",
  "created_by": "research_engine:aiops_vertical"
}
