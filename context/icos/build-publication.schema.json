{
  "$defs": {
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "maxLength": 40,
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "system",
        "tool",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    }
  },
  "$id": "urn:icdev-it:contract:build-publication:1:draft",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DRAFT by ICDEV[IT] (icx-ent-03) for ICDEV[OS] to adopt in osx-ent-06: the publication of one signed factory build (icos-artefact/v1), exported BESIDE it as {\"bundle\": <icos-release-transfer/v1>, \"publication\": ...}. A person who did not prepare the build took the declared step decl-wft-fb-build-publish, bound to the artefact digest (sha256: of artefact.json). ICDEV[OS] refuses a build with none, one at another digest, and one signed by its preparer or by an agent (icdev_os/publication.py check_publication).",
  "properties": {
    "content_digest": {
      "description": "the artefact digest: sha256 of artefact.json, the digest ICDEV[OS]'s admission recomputes",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "org": {
      "description": "the owning org (ICDEV[IT] tenant) of the build's target, the org the declared step was bound to and its publisher was of at export (icx-sec-01)",
      "maxLength": 120,
      "minLength": 1,
      "title": "Org",
      "type": "string"
    },
    "prepared_by": {
      "description": "a person's account id, or agent:<name>",
      "maxLength": 120,
      "minLength": 1,
      "title": "Prepared By",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "role": {
      "anyOf": [
        {
          "maxLength": 60,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "row_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Row Hash",
      "type": "string"
    },
    "schema": {
      "const": "icdev-build-publication/v1",
      "title": "Schema",
      "type": "string"
    },
    "signed_by": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Signed By",
      "type": "string"
    },
    "step_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Step Id",
      "type": "string"
    },
    "template": {
      "const": "decl-wft-fb-build-publish",
      "title": "Template",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "content_digest",
    "signed_by",
    "prepared_by",
    "step_id",
    "template",
    "decided_at",
    "event_id",
    "row_hash",
    "producer"
  ],
  "title": "Publication",
  "type": "object",
  "x-icos-contract": "draft",
  "x-license": "Apache-2.0"
}
