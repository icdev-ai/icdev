  "$id": "urn:icdev-os:contract:focus-cost:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A FOCUS cost bundle from ICDEV[IT]'s FinOps, per workload, for ICOS's Cloud CoP (osx-cop-05).",
  "properties": {
    "billing_period": {
      "$ref": "#/$defs/Period"
    },
    "classification": {
      "description": "what the producer claims; carried as a claim only -- ICOS marks the bundle by its own config",
      "title": "classification",
      "type": [
        "string",
        "null"
      ]
    },
    "content_digest": {
      "description": "SHA-256 over the canonical JSON (keys sorted, separators ',' and ':') of the bundle without content_digest, publication and produced_at",
      "pattern": "^[0-9a-f]{64}$",
