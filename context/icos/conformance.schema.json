  "$id": "urn:icdev-os:contract:conformance:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Owned by ICDEV[OS] (osx-coe-01); exported by ICDEV[IT] (tools/idp/conformance.py), in the style of the icos-apptwin/v1 contract. One bundle per repo (ICDEV[IT], ICDEV[OS], ICDEV[FT]): the engineering standards and their status against the repo, the scorecard results with their evidence, the exemptions that touch it (with expiry), the delivery metrics (DORA four keys and AI-assisted rework, each with its window, sample size and source digests), a summary of the linked ADRs, and the producer, version and time. content_digest is SHA-256 over the canonical JSON (keys sorted, separators ',' and ':', no whitespace) of the bundle without content_digest, publication and produced_at; ICOS recomputes it. publication is a person's declared step bound to that digest. Nothing unreported is a pass: unverified is said, with why.",
  "properties": {
    "adrs": {
      "$ref": "#/$defs/Adrs"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "classification": {
      "title": "Classification",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/FileDigest"
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "delivery": {
      "$ref": "#/$defs/Delivery"
    },
    "exemptions": {
      "items": {
        "$ref": "#/$defs/Exemption"
      },
      "title": "Exemptions",
      "type": "array"
    },
    "pinned_files": {
      "items": {
        "$ref": "#/$defs/PinnedFile"
      },
      "title": "Pinned Files",
      "type": "array"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "publication": {
      "anyOf": [
        {
          "$ref": "#/$defs/Publication"
        },
        {
