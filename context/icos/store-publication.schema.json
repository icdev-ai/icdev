{
  "$id": "urn:icdev-os:contract:store-publication:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The publication of one icos-store-package/v1, exported by ICDEV[IT] BESIDE it: a person who did not prepare it\ntook the declared step ``icos-store-publish``, bound to its content_digest. ICOS refuses a package with none, one at\nanother digest, and one signed by its preparer or by an agent (``icdev_os/publication.py``).",
  "properties": {
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "prepared_by": {
      "description": "a person's account id, or agent:<name>",
      "maxLength": 120,
      "minLength": 1,
      "title": "Prepared By",
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "maxLength": 60,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "row_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Row Hash",
      "type": "string"
    },
    "schema": {
      "const": "icos-store-publication/v1",
      "title": "Schema",
      "type": "string"
    },
    "signed_by": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Signed By",
      "type": "string"
    },
    "step_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Step Id",
      "type": "string"
    },
    "template": {
      "const": "icos-store-publish",
      "title": "Template",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "content_digest",
    "signed_by",
    "prepared_by",
    "step_id",
    "template",
    "decided_at",
    "event_id",
    "row_hash"
  ],
  "title": "StorePublication",
  "type": "object",
  "x-icos-contract": "1.207.0",
  "x-license": "Apache-2.0"
}
