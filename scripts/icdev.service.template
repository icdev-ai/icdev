# CUI // SP-CTI
# ICDEV™ systemd service unit template for Linux bare-metal deployment.
#
# A systemd --user unit. %h is a systemd specifier (the user's home), expanded
# by systemd itself -- do not edit it by hand. The file is valid as-is for a
# checkout at ~/icdev; for any other location install it with
#   python -m tools.genesis.install_units --platform linux --production
# which rewrites %h/icdev to the real checkout root and writes
# ~/.config/systemd/user/icdev.service, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now icdev
# To start at boot without a logon session: loginctl enable-linger "$USER".
#
# Install EITHER this unit OR scripts/systemd/icdev-genesis.{service,timer}:
# both run tools/genesis/launch.py, and its pid lock refuses the second one.
# A system-level unit (/etc/systemd/system) also needs a User= line naming the
# account that owns the checkout; a --user unit must not carry one.

[Unit]
Description=ICDEV™ — Intelligent Certified Development Services
Documentation=https://github.com/icdev-ai/icdev
After=network.target
# If Ollama is managed by systemd on this machine, uncomment:
# After=ollama.service
# Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=%h/icdev
ExecStart=%h/icdev/scripts/start-production.sh
Restart=on-failure
RestartSec=30s
# Graceful shutdown timeout (SIGTERM then SIGKILL)
TimeoutStopSec=60

# Environment — use EnvironmentFile to keep secrets out of the unit file
EnvironmentFile=%h/icdev/.env
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
Environment=ICDEV_GENESIS_ENABLED=true

# Security hardening (optional — uncomment for stricter sandboxing)
# NoNewPrivileges=yes
# PrivateTmp=yes
# ReadOnlyPaths=/usr /etc
# ReadWritePaths=%h/icdev/data %h/icdev/.tmp

# Stdout/stderr go to journald (use: journalctl -u icdev -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=icdev

[Install]
WantedBy=default.target
