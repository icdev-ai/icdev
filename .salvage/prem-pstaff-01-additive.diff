+-- Bid-side key personnel: who we are proposing, at which LCAT, and whether they
+-- clear the solicitation's qualification bar. pg_lcat_allocations is task->LCAT->FTE
+-- (never names a human) and pma_personnel is post-award (keyed on contract_id), so
+-- without this the bid side had no people table and program_bridge scraped names out
+-- of draft prose. Append-only: verdict changes and withdrawals append a new revision.
+-- CHECK values mirror QUALIFICATION_VERDICTS / PERSON_SOURCES / PERSON_STATUSES in
+-- tools/govcon/key_personnel.py, which is the source of truth (migration 266).
+CREATE TABLE IF NOT EXISTS proposal_key_personnel (
+    id TEXT PRIMARY KEY,
+    opportunity_id TEXT NOT NULL,
+    person_ref TEXT NOT NULL,
+    name TEXT NOT NULL,
+    proposed_lcat TEXT,
+    qualification_verdict TEXT DEFAULT 'unverified'
+        CHECK(qualification_verdict IN ('unverified', 'qualified', 'gap', 'not_qualified')),
+    evidence_json TEXT DEFAULT '[]',
+    source TEXT NOT NULL DEFAULT 'manual'
+        CHECK(source IN ('manual', 'resume', 'llm_extraction', 'draft_scrape', 'import', 'compass')),
+    status TEXT NOT NULL DEFAULT 'proposed'
+        CHECK(status IN ('proposed', 'withdrawn')),
+    notes TEXT,
+    created_at TEXT NOT NULL,
+    created_by TEXT,
+    classification TEXT DEFAULT 'CUI',
+    tenant_id TEXT
+);
+CREATE INDEX IF NOT EXISTS idx_pkp_opp ON proposal_key_personnel(opportunity_id);
+CREATE INDEX IF NOT EXISTS idx_pkp_ref ON proposal_key_personnel(opportunity_id, person_ref);
+
