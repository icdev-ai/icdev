+class ForceLocalViolation(RuntimeError):
+    """Raised when a ``force_local: true`` function has no local model left to run on.
+
+    This is the fail-closed rung of the CUI egress guarantee (prem-p0-02). A
+    function marked ``force_local`` in ``args/llm_config.yaml`` handles raw
+    CUI (proposal prose, pricing, past performance). If every model in its
+    chain resolves to a cloud provider, the correct behavior is to REFUSE the
+    call — never to quietly fall through to cloud.
+    """
+
+    def __init__(self, message: str, *, function: str = "", chain=None):
+        super().__init__(message)
+        self.function = function
+        self.chain = list(chain or [])
+
