+    def is_force_local(self, function: str) -> bool:
+        """True if *function* is declared ``force_local`` in ``args/llm_config.yaml``.
+
+        Public so the content-policy resolver (prem-p0-01) can honor it as the
+        top rung without re-parsing the config.
+        """
+        routing = self._config.get("routing", {})
+        route = routing.get(function, routing.get("default", {})) or {}
+        return bool(route.get("force_local", False))
