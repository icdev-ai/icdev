+        """Register an EVIDENCED person -> LCAT staffing matrix for a bid.
+
+        Assignments land in proposal_key_personnel, which the program bridge's
+        staffing plan reads — so a person pushed here appears as a real mapping
+        (name, LCAT, qualification verdict, evidence) rather than a name scraped
+        out of draft prose.
+
+        Each assignment is ``{"name", "proposed_lcat", "evidence", ...}`` plus the
+        optional ``person_ref`` (stable id; re-pushing updates in place),
+        ``qualification_verdict`` (qualified | gap | exceeds), and ``source``.
+        Evidence is rendered text or a list of {"claim", "source"} citations.
+
+        A person mapped to an LCAT with NO qualifying evidence is REFUSED
+        server-side (returned in ``refused``), never stored with an empty
+        evidence field — an unevidenced mapping is an assertion nobody can defend
+        at debrief. Refusing one person does not block the evidenced ones.
+        """
+        payload: Dict[str, Any] = {"opportunity_id": opportunity_id,
+                                   "assignments": assignments}
+        return self._post("staffing_matrix", payload, timeout)
