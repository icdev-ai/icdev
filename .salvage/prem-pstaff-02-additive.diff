+@_cortex_api(scope="staffing")
+def api_v1_staffing_matrix(data):
+    """Register an EVIDENCED proposal staffing matrix (prem-pstaff-02).
+
+    Intake for the person -> proposed-LCAT mapping an external capture tool
+    (compass) has already built and QUALIFIED. Accepted rows land in
+    ``proposal_key_personnel``, which ``program_bridge._gather_key_personnel``
+    reads — so a pushed person appears in the staffing plan as a real mapping
+    (name, LCAT, verdict, evidence) instead of a name regex-scraped out of draft
+    prose, which is what the bid side had before.
+
+    EVERY MAPPING MUST CARRY QUALIFYING EVIDENCE. A person mapped to an LCAT with
+    no evidence is REFUSED, not stored with an empty evidence field. This is the
+    same defect class as an uncited win theme: the mapping is what the proposal
+    asserts to the government about who will do the work, so an unevidenced one
+    is an assertion nobody can defend at debrief. Compass sends only evidenced
+    mappings; this is the server-side half of that contract, because "the client
+    checked" is not a security property. Refusing one person does not block the
+    evidenced ones — a 200 with a non-empty ``refused`` list is the normal,
+    honest outcome, and the caller is told exactly who did not make it.
+    """
+    from tools.govcon.key_personnel import VERDICTS, register_person
+
+    if not isinstance(data, dict):
+        raise validators.CortexValidationError("body must be a JSON object")
+
+    opportunity_id = str(data.get("opportunity_id") or "").strip()
+    if not opportunity_id:
+        raise validators.CortexValidationError("opportunity_id is required")
+
+    assignments = data.get("assignments")
+    if not isinstance(assignments, list) or not assignments:
+        raise validators.CortexValidationError("assignments must be a non-empty list")
+
+    ctx = _server_context(validators.domain_of(data))
+    registered, refused = [], []
+
+    for index, assignment in enumerate(assignments):
+        if not isinstance(assignment, dict):
+            raise validators.CortexValidationError(
+                f"assignment {index} must be an object")
+
+        # A row with no person or no LCAT is not a mapping at all — that is a
+        # malformed request (400), not a person we are declining to trust.
+        name = str(assignment.get("name") or "").strip()
+        if not name:
+            raise validators.CortexValidationError(f"assignment {index} has no name")
+        proposed_lcat = str(assignment.get("proposed_lcat") or "").strip()
+        if not proposed_lcat:
+            raise validators.CortexValidationError(
+                f"assignment {index} ({name}) has no proposed_lcat")
+
+        verdict = str(assignment.get("qualification_verdict") or "qualified")
+        if verdict not in VERDICTS:
+            raise validators.CortexValidationError(
+                f"qualification_verdict must be one of {VERDICTS}")
+
+        result = register_person(
+            opportunity_id,
+            name,
+            proposed_lcat,
+            assignment.get("evidence"),
+            person_ref=assignment.get("person_ref") or None,
+            qualification_verdict=verdict,
+            source=assignment.get("source") or None,
+            tenant_id=ctx.tenant_id,
+            classification=ctx.classification,
+        )
+        if result.get("status") == "refused":
+            refused.append({"name": name, "proposed_lcat": proposed_lcat,
+                            "reason": result["reason"]})
+            continue
+        if result.get("status") != "ok":
+            raise validators.CortexValidationError(
+                f"assignment {index} ({name}): {result.get('message', 'rejected')}")
+        registered.append({
+            "person_id": result["person_id"], "person_ref": result["person_ref"],
+            "name": name, "proposed_lcat": proposed_lcat,
+            "qualification_verdict": verdict,
+            "evidence_count": result["evidence_count"],
+        })
+
+    logger.info("staffing-matrix intake: %d registered, %d refused for opportunity %s",
+                len(registered), len(refused), opportunity_id)
+    return {
+        "opportunity_id": opportunity_id,
+        "registered": registered,
+        "refused": refused,
+        "registered_count": len(registered),
+        "refused_count": len(refused),
+    }
+
