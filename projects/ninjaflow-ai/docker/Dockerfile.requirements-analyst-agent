# [TEMPLATE: CUI // SP-CTI]
# NINJAFLOW_AI Requirements Analyst Agent — STIG-Hardened
# Controlled by: Department of Defense | CUI Category: CTI | Distribution: D
# Port: 8453 | Tier: Domain

FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim

LABEL classification="CUI" \
      dissemination_control="SP-CTI" \
      originator="NINJAFLOW_AI" \
      description="NINJAFLOW_AI Requirements Analyst Agent — Conversational Intake, Gap Detection, SAFe Decomposition" \
      port="8453" \
      agent="requirements-analyst-agent"

# STIG: Create non-root user with explicit UID/GID
RUN groupadd -g 1000 ninjaflow_ai && \
    useradd -u 1000 -g ninjaflow_ai -d /app -s /usr/sbin/nologin ninjaflow_ai

# STIG: Install only required runtime packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/apt-get

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application
WORKDIR /app
COPY --chown=ninjaflow_ai:ninjaflow_ai . .

# STIG: Set restrictive permissions
RUN chmod -R 750 /app && \
    find /app -type f -name "*.py" -exec chmod 640 {} +

# Data directory for SQLite (mounted as volume in production)
RUN mkdir -p /app/data && chown ninjaflow_ai:ninjaflow_ai /app/data

ENV PYTHONUNBUFFERED=1

# STIG: Run as non-root
USER ninjaflow_ai

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8453/health || exit 1

EXPOSE 8453

ENTRYPOINT ["python", "tools/a2a/agent_server.py", "--agent-id", "requirements-analyst-agent", "--port", "8453"]
