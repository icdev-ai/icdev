include pyproject.toml README.md CHANGELOG.md CONTRIBUTING.md LICENSE NOTICE
include CLAUDE.md .mcp.json ruff.toml requirements.txt .env.sample

recursive-include icdev *.py *.html *.css *.js *.json *.yaml *.yml
recursive-include icdev *.sql *.md *.txt *.LICENSE *.feature *.j2 *.toml *.ini

# Claude bootstrap (CLAUDE.md, .claude/commands/, .claude/hooks/, .mcp.json)
# Populated by tools/installer/prebuild_bootstrap.py before `python -m build`.
# Shipped under icdev/data/claude_bootstrap/ so `icdev init` can copy it
# into user projects.
recursive-include icdev/data/claude_bootstrap *

# Keep in sync with tools/installer/sync_package_tree.py PARENT_ONLY_DIRS
# and pyproject.toml [tool.setuptools.packages.find] exclude.
# Owner-operated child apps — NOT shipped:
recursive-exclude icdev/tools/pulse *
recursive-exclude icdev/tools/proposal_genesis *
recursive-exclude icdev/tools/govcon *
recursive-exclude icdev/tools/rfx *
recursive-exclude icdev/tools/autoresearch *
recursive-exclude icdev/tools/scout *
recursive-exclude icdev/tools/creative *
recursive-exclude icdev/tools/trading *
recursive-exclude icdev/tools/market_intel *
# Parent-platform services — NOT shipped:
recursive-exclude icdev/tools/saas *
recursive-exclude icdev/tools/marketplace *
recursive-exclude icdev/tools/gateway *
recursive-exclude icdev/tools/playground *

recursive-exclude * __pycache__ *.py[cod] *.so *.egg-info

prune .git
prune .github
prune .tmp
prune .claude
prune agents
prune audit
prune data
prune deploy
prune docker
prune k8s
prune node_modules
prune playwright
prune projects
prune specs
prune vendor
prune videos
prune tools

exclude .env .env.local .secrets.baseline
exclude package.json package-lock.json playwright-mcp-config.json playwright.config.ts
