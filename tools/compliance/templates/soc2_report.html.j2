{# CUI // SP-CTI #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SOC 2 Evidence Report — {{ tenant_id }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 2rem; color: #222; }
    .cui-banner { background:#ffcc00; color:#000; padding:.4rem 1rem; font-weight:bold;
                  text-align:center; border:2px solid #b8860b; margin-bottom:1.5rem; }
    h1 { font-size:1.4rem; margin-bottom:.25rem; }
    .meta { color:#555; font-size:.85rem; margin-bottom:1.5rem; }
    .summary-grid { display:flex; gap:2rem; margin-bottom:2rem; flex-wrap:wrap; }
    .summary-card { border:1px solid #ddd; border-radius:6px; padding:1rem 1.5rem;
                    background:#f9f9f9; min-width:140px; text-align:center; }
    .summary-card .val { font-size:2rem; font-weight:bold; color:#1a56db; }
    .summary-card .lbl { font-size:.8rem; color:#555; margin-top:.2rem; }
    .progress-bar-wrap { background:#e5e7eb; border-radius:9999px; height:18px;
                         width:100%; max-width:400px; margin-bottom:2rem; overflow:hidden; }
    .progress-bar-fill { background:#1a56db; height:100%; border-radius:9999px;
                         transition:width .3s ease; }
    table { border-collapse:collapse; width:100%; font-size:.87rem; }
    th { background:#1a56db; color:#fff; padding:.5rem .75rem; text-align:left; }
    td { padding:.45rem .75rem; border-bottom:1px solid #e5e7eb; vertical-align:top; }
    tr:nth-child(even) td { background:#f4f6fb; }
    .badge-ev { background:#d1fae5; color:#065f46; border-radius:4px;
                padding:.1rem .4rem; font-size:.78rem; font-weight:600; }
    .badge-no { background:#fee2e2; color:#991b1b; border-radius:4px;
                padding:.1rem .4rem; font-size:.78rem; font-weight:600; }
    .cat-CC { color:#1a56db; } .cat-A { color:#0369a1; } .cat-PI { color:#7c3aed; }
    .cat-C  { color:#d97706; } .cat-P  { color:#059669; }
    .section-title { font-size:1.1rem; font-weight:600; margin:2rem 0 .75rem; border-bottom:2px solid #e5e7eb; padding-bottom:.3rem; }
  </style>
</head>
<body>
<div class="cui-banner">CUI // SP-CTI — CONTROLLED UNCLASSIFIED INFORMATION</div>

<h1>SOC 2 Evidence Report</h1>
<div class="meta">
  Tenant: <strong>{{ tenant_id }}</strong> &nbsp;|&nbsp;
  Framework: <strong>{{ framework | upper }}</strong> &nbsp;|&nbsp;
  Generated: <strong>{{ generated_at }}</strong>
</div>

<div class="summary-grid">
  <div class="summary-card">
    <div class="val">{{ summary.total_controls }}</div>
    <div class="lbl">Total Controls</div>
  </div>
  <div class="summary-card">
    <div class="val" style="color:#065f46">{{ summary.evidenced }}</div>
    <div class="lbl">Evidenced</div>
  </div>
  <div class="summary-card">
    <div class="val" style="color:#991b1b">{{ summary.total_controls - summary.evidenced }}</div>
    <div class="lbl">Not Evidenced</div>
  </div>
  <div class="summary-card">
    <div class="val">{{ summary.coverage_pct }}%</div>
    <div class="lbl">Coverage</div>
  </div>
</div>

<div class="progress-bar-wrap">
  <div class="progress-bar-fill" style="width:{{ summary.coverage_pct }}%"></div>
</div>

<div class="section-title">Control Coverage Detail</div>
<table>
  <thead>
    <tr>
      <th>Control ID</th>
      <th>Category</th>
      <th>Description</th>
      <th>Status</th>
      <th>Evidence Items</th>
      <th>Last Collected</th>
    </tr>
  </thead>
  <tbody>
    {% for ctrl in controls | sort(attribute='control_id') %}
    <tr>
      <td><strong>{{ ctrl.control_id }}</strong></td>
      <td class="cat-{{ ctrl.category }}">{{ ctrl.category }}</td>
      <td>{{ ctrl.description }}</td>
      <td>
        {% if ctrl.status == 'evidenced' %}
        <span class="badge-ev">Evidenced</span>
        {% else %}
        <span class="badge-no">Not Evidenced</span>
        {% endif %}
      </td>
      <td>{{ ctrl.evidence_count }}</td>
      <td>{{ ctrl.last_collected or '—' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<div style="margin-top:2rem; font-size:.75rem; color:#888;">
  Generated by ICDEV™ SOC 2 Exporter &nbsp;|&nbsp; CUI // SP-CTI
</div>
</body>
</html>
