{
  "classification": "CUI // SP-CTI",
  "description": "RAG source type to DB table/column mappings (D26 declarative context)",
  "version": "1.0.0",
  "phase": 64,
  "source_categories": {
    "innovation": {
      "description": "Innovation Engine outputs",
      "sources": ["innovation_signals", "innovation_solutions", "innovation_trends"]
    },
    "creative": {
      "description": "Creative Engine customer-centric outputs",
      "sources": ["creative_pain_points", "creative_feature_gaps", "creative_specs", "creative_trends"]
    },
    "research": {
      "description": "Industry Research Engine outputs",
      "sources": ["research_dossiers", "research_challenges", "research_forecasts"]
    },
    "compliance": {
      "description": "Compliance artifacts and audit events",
      "sources": ["compliance_artifacts", "atlas_critique_findings"]
    },
    "memory": {
      "description": "Memory system entries",
      "sources": ["memory_entries"]
    },
    "operations": {
      "description": "Operational data (batch only)",
      "sources": ["audit_trail", "ai_telemetry", "agent_memory", "code_quality_metrics"]
    }
  },
  "ingestion_modes": {
    "realtime": {
      "description": "Ingested immediately via extension hook on write",
      "trigger": "TOOL_EXECUTE_AFTER extension hook (020_rag_ingestion.py)"
    },
    "batch": {
      "description": "Ingested periodically via sweep command",
      "trigger": "python tools/rag/ingestion_manager.py --sweep"
    }
  }
}
