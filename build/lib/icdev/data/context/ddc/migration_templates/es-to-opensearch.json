{
  "template_id": "ddc-tpl-es-opensearch",
  "name": "Elasticsearch → OpenSearch Migration",
  "description": "Data lineage template: ES S3 snapshot → OpenSearch Service restore with index/alias migration and Bedrock KB integration",
  "source_tech": "elasticsearch",
  "target_tech": "opensearch",
  "migration_tool": "snapshot_restore",
  "nodes": [
    {
      "node_id": "src-es-cluster",
      "label": "Elasticsearch 8 Cluster",
      "node_type": "source",
      "tech": "elasticsearch",
      "properties": {"version": "8.11", "shards": 5, "indices": 12, "platform": "kubernetes"}
    },
    {
      "node_id": "transform-s3-snapshot",
      "label": "S3 Snapshot Repository",
      "node_type": "transform",
      "tech": "s3",
      "properties": {"bucket": "es-migration-snapshots", "snapshot_policy": "daily"}
    },
    {
      "node_id": "transform-index-template",
      "label": "Index Template Migration",
      "node_type": "transform",
      "tech": "opensearch",
      "properties": {"tool": "opensearch-python-client", "alias_rewrite": true}
    },
    {
      "node_id": "tgt-opensearch",
      "label": "OpenSearch Service",
      "node_type": "target",
      "tech": "opensearch",
      "properties": {"version": "2.11", "data_nodes": 3, "instance_type": "r6g.xlarge.search"}
    },
    {
      "node_id": "tgt-bedrock-kb",
      "label": "Bedrock Knowledge Base",
      "node_type": "target",
      "tech": "bedrock-kb",
      "properties": {"vector_store": "opensearch", "chunking_strategy": "fixed_size", "chunk_size": 512}
    }
  ],
  "edges": [
    {"source": "src-es-cluster", "target": "transform-s3-snapshot", "edge_type": "snapshot", "label": "ES snapshot to S3"},
    {"source": "transform-s3-snapshot", "target": "tgt-opensearch", "edge_type": "restore", "label": "restore from S3 snapshot"},
    {"source": "src-es-cluster", "target": "transform-index-template", "edge_type": "schema_export", "label": "export index templates + aliases"},
    {"source": "transform-index-template", "target": "tgt-opensearch", "edge_type": "schema_apply", "label": "apply templates + aliases"},
    {"source": "tgt-opensearch", "target": "tgt-bedrock-kb", "edge_type": "vector_store", "label": "Bedrock KB vector index"}
  ],
  "sop_hints": ["snapshot/restore", "index template", "bedrock knowledge base"]
}
