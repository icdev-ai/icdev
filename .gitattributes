# Cross-platform line ending enforcement
* text=auto eol=lf

# Explicitly mark as text (LF)
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.feature text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf

# Binary files
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pkl binary
*.gguf binary
*.bin binary
*.enc binary
