# EQUINIX_ECX_CLIENT_SECRET=your-equinix-client-secret

# Megaport (VXCs, ports, MCRs)
# MEGAPORT_USER=your-megaport-username
# MEGAPORT_PASS=your-megaport-password

# PeeringDB (PMC canvas — optional API key for higher rate limits)
# PEERINGDB_API_KEY=your-peeringdb-api-key

# ============================================================================
# FILESYNC — File synchronization (disabled by default)
# ============================================================================
ICDEV_FILESYNC_ENABLED=false

# ============================================================================
# SIPA — Software Integrity & Provenance Assessor (tools/integrity/, /integrity)
# ============================================================================
# Static-only assessor that detects unauthorized/malicious code (human- or
# AI-introduced) not part of the original requirement/PRD. Quarantine-first
# with a HITL blocking gate. Behavior tuned in args/integrity_config.yaml.
ICDEV_INTEGRITY_ENABLED=true

# ============================================================================
# ACF — Autonomous Capability Foundry (disabled by default; opt-in autonomy)
# ============================================================================
# Master switch for the Foundry autonomous product factory.
# When false, the Foundry modules are never imported, the API blueprint
# isn't registered, and the Genesis scheduler won't spawn foundry tasks.
# Behavior tuned in args/foundry_config.yaml.
ICDEV_FOUNDRY_ENABLED=false

# ============================================================================
# PYPI PUBLISHING — Package distribution (maintainers only)
# ============================================================================
# Generate at: https://pypi.org/manage/account/token/
# PYPI_API_TOKEN=
# TWINE_USERNAME=__token__
# TWINE_PASSWORD=

# ============================================================================
# FATHOMDESK — Secrets backend (Phase 2D, optional)
# ============================================================================
# Pluggable storage for per-user API credentials (Anthropic, OpenAI,
# Alpaca, etc.). Default is `local` — encrypted in the FathomDesk database
# via AES-GCM (keyed by ICDEV_KEYSTORE_KEY; users can additionally opt
# into per-user Path B vault mode for password-derived encryption).
#
# Switch to `vault` to delegate storage to HashiCorp Vault / OpenBao.
# When vault backend is active:
#   - Vault becomes the trust root — it encrypts + stores the secrets
#   - Path B (per-user vault mode) is inactive (Vault replaces it)
#   - Requires: pip install hvac (it's commented in requirements.txt)
#
# ICDEV_SECRET_BACKEND=local       # default
# ICDEV_SECRET_BACKEND=vault

# Required when ICDEV_SECRET_BACKEND=vault:
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=hvs.YOUR-VAULT-TOKEN-HERE   # raw token; AppRole / K8s / IAM auth are follow-ups
# VAULT_MOUNT_PATH=secret           # KV v2 mount path (default "secret")
# VAULT_NAMESPACE=                  # optional (Vault Enterprise namespace)
#
# Secrets land under: {mount}/data/fathomdesk/credentials/{user_id}/{provider}

# ============================================================================
# FATHOMDESK — Stripe billing (Phase 5B, optional)
# ============================================================================
# All three must be set for Checkout + Portal + webhooks to work.
# Omit entirely on air-gap / operator-managed deployments — /api/billing/tier
# direct-set path remains functional for manual tier assignment.
#
# Dashboards:
#   https://dashboard.stripe.com/apikeys            (secret + publishable)
#   https://dashboard.stripe.com/webhooks           (endpoint + signing secret)
#   https://dashboard.stripe.com/products           (create Prices → IDs below)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs per paid tier. Created once in Stripe Dashboard; copy IDs here.
# Resolved in this order: plan_tiers.yaml stripe_price_id → this env var.
# Free tier has no price. Enterprise may stay blank (contact-sales).
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Optional: public URLs for post-checkout redirects. Defaults to dashboard
# host; override if the dashboard is behind a reverse proxy.
# STRIPE_SUCCESS_URL=https://app.example.com/billing?checkout=success
# STRIPE_CANCEL_URL=https://app.example.com/billing?checkout=cancel
