# ============================================================================
# SBOM — 2026 Minimum Elements
# ============================================================================
# Component Producer for the software the SBOM DESCRIBES: the full name of the
# organization that creates, defines and identifies it. This is the target
# component's producer, NOT the SBOM Author — the author generates the document,
# the producer builds the software, and the 2026 elements keep them separate.
# Dependencies resolve their own producer from their own package metadata; this
# setting only names yours. Left unset, the generator reads the project's own
# manifest, and failing that marks the target component of unknown provenance
# rather than guessing at it.
# ICDEV_SBOM_PRODUCER=Defense Information Systems Agency
#
# SBOM Author: the full name of the ENTITY that generates the SBOM — the
# organization operating this generator. Explicitly not the tool and not the
# tool's vendor; `metadata.tools[].vendor` stays "ICDEV™" and means the vendor of
# the tool. Full names, no acronyms unless the acronym is the official name. May
# be the same entity as ICDEV_SBOM_PRODUCER above without being the same element.
# Overridden per run by `--author`. Left unset, the generator names the platform
# in full rather than leaving the element blank.
# ICDEV_SBOM_AUTHOR=Defense Information Systems Agency

# ============================================================================
# CANVAS DATABASE — Storage backend for canvas databases (continued above)
# ============================================================================

# ============================================================================
# GOVCON / GovProposal / CPMP (disabled by default; opt-in only)
# ============================================================================
# Master switch for the GovCon Intelligence + GovProposal + CPMP modules
# (SAM.gov scanning, requirement extraction, capability mapping, proposal
# lifecycle, contract performance management). When false, the GovCon
# Python modules are never imported, the API blueprints aren't
# registered, the SSR pages don't exist, and the navigation menu hides
# the GovCon dropdown entirely.
#
# Forced OFF in air-gap mode (ICDEV_AIRGAP=true) regardless of this
# value, since GovCon depends on cloud / SAM.gov access.
ICDEV_GOVCON_ENABLED=false

# SAM.gov API Key — register at https://sam.gov/content/entity-registration
SAM_GOV_API_KEY=

# ============================================================================
# KANBAN — Task orchestration
# ============================================================================
ICDEV_KANBAN_EXECUTOR_CHAIN=claude_cli,gitlab,ollama_local
ICDEV_KANBAN_PR_FLOW=false

# ============================================================================
# GITHUB — CI/CD and kanban executor
# ============================================================================
# Generate at: https://github.com/settings/tokens (scopes: repo, workflow)
GITHUB_TOKEN=
GITHUB_RUNNER_REPO=

# ============================================================================
# AWS EMULATOR — floci (local AWS API for Studio executors + DataBridge)
# ============================================================================
# tools/cloud/emulator.py is the ONE switch (flx-seam-01). Every consumer asks
# it — tools/studio/executors/_base.py::detect_mode, which is the switch under
# `terraform apply`, and tools/databridge/feature_flags.py::localstack — and
# nothing reads these names directly. Read the current verdict with:
#   python -c "from tools.cloud import emulator; print(emulator.status(probe=False))"
#
# Master switch. Default false: a deployment that declares nothing reaches no
# emulator, which is the air-gap-safe posture. Set true only with floci running.
FLOCI_ENABLED=false

# THE FOUR SETTINGS BELOW ARE COMMENTED OUT ON PURPOSE. Each shows the default
# the seam already applies, so uncommenting one changes behaviour and leaving it
# alone changes nothing.
#
# LEAVE FLOCI_ENDPOINT COMMENTED UNLESS YOU MEAN IT. An endpoint declared while
# FLOCI_ENABLED is false is a CONTRADICTION, and detect_mode() answers `dry_run`
# rather than guess — reading it as "no emulator, so use real AWS" is how an
# apply written for localhost reaches a real account. So an .env that declares
# an endpoint with the switch off turns every REAL `terraform apply` into a
# plan-only run, silently.
#
# Emulator base URL, trailing slash stripped. Default: http://localhost:4566
# FLOCI_ENDPOINT=http://localhost:4566
#
# Region handed to the emulated clients. Default: us-gov-west-1 — ICDEV's
# target partition, chosen by the seam rather than inherited from the emulator.
# FLOCI_REGION=us-gov-west-1
#
# 12-digit AWS account id floci isolates its state per. Default: 000000000000.
# A value that is not exactly 12 digits logs one line and falls back to that
# default — so two deployments that both mis-set it SHARE emulator state.
# FLOCI_ACCOUNT_ID=000000000000
#
# Docker socket, needed ONLY by the container-backed services (Lambda, RDS,
# ElastiCache, OpenSearch, MSK, ECS/EC2/EKS); everything else is served
# in-process. Falls back to DOCKER_HOST, then to /var/run/docker.sock. Unset on
# Windows reads as "cannot tell", never "absent", so a working Docker Desktop is
# never refused. Default: unset.
# FLOCI_DOCKER_SOCKET=/var/run/docker.sock
#
# There is deliberately NO credential setting here: emulator.credentials()
# always returns the dummy ("test", "test") pair and reads no environment at
# all. The emulator accepts any non-empty pair, and these values are passed to
# `docker run -e` and into a Terraform provider block — so honouring a real
# AWS_ACCESS_KEY_ID exported in the same shell would hand live GovCloud
# credentials to a container talking to localhost.

# --- Deprecated aliases (deprecated 2026-09-04) ---
# Still READ, and each resolution logs one warning per alias per process. They
# are honoured rather than dropped because floci's own compat layer honours them
# by default, and because tools/infra_canvas/dockerfile_generator.py has already
# emitted these names into compose files we do not control. A canonical FLOCI_*
# name always wins; an empty one does not mask a set alias. Prefer FLOCI_*:
#   LOCALSTACK_ENABLED   -> FLOCI_ENABLED
#   LOCALSTACK_ENDPOINT  -> FLOCI_ENDPOINT
#   LOCALSTACK_REGION    -> FLOCI_REGION

