# ============================================================================
# ICDEV — Intelligent Certified Development
# Environment Configuration Reference
# ============================================================================
# Copy to .env and edit values for your environment.
# All LLM model names, API keys, and routing config go here.
# No need to edit llm_config.yaml or Python code.
# ============================================================================

# ============================================================================
# LLM — Primary Local Model (Ollama)
# ============================================================================
# Ollama is the primary LLM. Free, local, air-gap safe.
# Install: https://ollama.com | Then: ollama pull qwen3.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# ============================================================================
# LLM — Cloud Providers (all optional)
# ============================================================================
# Leave blank to disable. Set API key to enable.

# --- Anthropic Claude ---
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- AWS Bedrock ---
# Uses IAM credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or instance role)
AWS_DEFAULT_REGION=us-gov-west-1

# --- IBM watsonx.ai ---
IBM_CLOUD_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- vLLM (self-hosted) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

# ============================================================================
# LLM — Two-Tier Routing
# ============================================================================
# Ollama drafts, cloud LLM reviews. Set to false for Ollama-only mode.
LLM_TWO_TIER_ENABLED=true

# Confidence threshold — below this, LLM enhancement activates
LLM_CONFIDENCE_THRESHOLD=0.85

# ============================================================================
# RAG — Retrieval-Augmented Generation
# ============================================================================
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_VECTOR_STORE=auto

# ============================================================================
# FINE-TUNING
# ============================================================================
FINETUNE_ENABLED=true
FINETUNE_MIN_EXAMPLES=50
FINETUNE_BASE_MODEL=qwen3.5:latest

# ============================================================================
# DASHBOARD
# ============================================================================
ICDEV_DASHBOARD_SECRET=change-me-in-production
ICDEV_CUI_BANNER_ENABLED=true
ICDEV_BYOK_ENABLED=false

# ============================================================================
# CLASSIFICATION
# ============================================================================
# CUI // SP-CTI for IL4/IL5, SECRET for IL6
# Leave blank for UNCLASSIFIED
ICDEV_CLASSIFICATION=CUI
ICDEV_IMPACT_LEVEL=IL4

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
