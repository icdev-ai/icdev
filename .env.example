# ============================================================================
# ICDEV — Intelligent Certified Development
# Environment Configuration Reference
# ============================================================================
# Copy to .env and edit values for your environment.
# All LLM model names, API keys, and routing config go here.
# No need to edit llm_config.yaml or Python code.
# ============================================================================

# ============================================================================
# PYTHON PATH
# ============================================================================
PYTHONPATH=.

# ============================================================================
# LLM — Primary Local Model (Ollama)
# ============================================================================
# Ollama is the primary LLM. Free, local, air-gap safe.
# Install: https://ollama.com | Then: ollama pull qwen3.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# Ollama Cloud API (moonshot/kimi or similar cloud-hosted Ollama endpoint)
# OLLAMA_CLOUD_BASE_URL=https://your-ollama-cloud-endpoint
OLLAMA_API_KEY=
LLM_PROVIDER=ollama_cloud

# ============================================================================
# LLM — Cloud Providers (all optional)
# ============================================================================
# Leave blank to disable. Set API key to enable.

# --- Anthropic Claude ---
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- LLM Proxy / Virtual Keys (LPX) — OPT-IN, OFF BY DEFAULT ---
# Route cloud providers through the opt-in LiteLLM proxy
# (docker compose --profile llm-proxy up). When disabled (the default) every
# provider uses its real endpoint above. DISTINCT from ICDEV_LLM_PROXY (the
# corporate HTTPS egress proxy in tools/llm/proxy_resolver.py) — both may be set
# and compose cleanly.
#ICDEV_LLM_PROXY_ENABLED=false
#ICDEV_LLM_PROXY_BASE_URL=http://localhost:4000
# Virtual key presented to the proxy INSTEAD of a real provider key. Issue via
# tools/llm/proxy_keys.py (lpx-keys-01). NEVER put a real provider key here.
#ICDEV_LLM_PROXY_VIRTUAL_KEY=
# Admin/master key for the proxy management API (the compose service).
#LITELLM_MASTER_KEY=

# --- OpenAI ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Featherless.ai (open-weights model hosting) ---
# Get key: https://featherless.ai
FEATHERLESS_API_KEY=

# --- OpenRouter (unified gateway to 200+ models) ---
# Get key: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=

# --- Google Gemini ---
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Google Workspace OAuth2 (Second Brain integrations — Calendar, Gmail contacts) ---
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Scopes: calendar.readonly, gmail.readonly, contacts.readonly, userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Microsoft 365 / Graph API (Second Brain integrations — optional) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Email delivery (SMTP — optional, used if M365 not configured) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- AWS Bedrock ---
# Uses IAM credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or instance role)
AWS_DEFAULT_REGION=us-gov-west-1

# --- IBM watsonx.ai ---
IBM_CLOUD_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- vLLM (self-hosted) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

# ============================================================================
# LLM — DIC AI-Assist model selection (Chain-of-Debate)
# ============================================================================
# Comma-separated model aliases defined in args/llm_config.yaml
DIC_GEN_DEBATERS=minimax-m3,mistral-large-cloud,gemini3-cloud
DIC_GEN_SYNTHESIZER=mistral-large-cloud
DIC_GEN_MODEL=mistral-large-cloud

# ============================================================================
# LLM — Two-Tier Routing
# ============================================================================
# Ollama drafts, cloud LLM reviews. Set to false for Ollama-only mode.
LLM_TWO_TIER_ENABLED=true

# Confidence threshold — below this, LLM enhancement activates
LLM_CONFIDENCE_THRESHOLD=0.85

# ============================================================================
# RAG — Retrieval-Augmented Generation
# ============================================================================
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_VECTOR_STORE=auto

# ============================================================================
# FINE-TUNING
# ============================================================================
FINETUNE_ENABLED=true
FINETUNE_MIN_EXAMPLES=50
FINETUNE_BASE_MODEL=qwen3.5:latest

# ============================================================================
# DATABASE — PostgreSQL (required for container/production mode)
# ============================================================================
# Used by docker-compose.yml postgres service AND tools/db/storage.py when
# ICDEV_STORAGE_BACKEND=postgresql.
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(32))"
ICDEV_PG_PASSWORD=change-me-in-production
ICDEV_PG_USER=icdev
ICDEV_PG_DB=icdev
ICDEV_PG_HOST=localhost
ICDEV_PG_PORT=5432
ICDEV_STORAGE_BACKEND=sqlite
ICDEV_DATABASE_URL=postgresql://icdev:change-me-in-production@localhost:5432/icdev
# Set true to disable SQLite fallback (production hardening)
ICDEV_PG_NO_FALLBACK=false
# Alpine/container image selector (debian-runtime or alpine-runtime)
# ICDEV_DOCKER_TARGET=debian-runtime

# ============================================================================
# CANVAS DATABASE — Storage backend for canvas databases
# ============================================================================
# Global fallback: all canvas init_db files use this unless per-canvas override set.
# ICDEV_CANVAS_STORAGE_BACKEND=sqlite
# Per-canvas overrides (uncomment to override global):
# IDC_STORAGE_BACKEND=sqlite
NC_STORAGE_BACKEND=sqlite
# NC_PG_DATABASE / PC_PG_DATABASE / IDC_PG_DATABASE are GONE, not renamed.
# They never had any effect on PostgreSQL: get_connection() ignores db_path
# there and returns the shared icdev database, so canvas tables live in icdev
# namespaced by their table-name prefix (nc_*, pdc_*, infra_*) — which is the
# platform's design. Setting one only misled: measured 2026-08-16, the
# network_canvas database on the live box existed with ZERO tables while icdev
# held 139 nc_* tables. If you created one of these databases, it is empty and
# can be dropped.
# SC_STORAGE_BACKEND=sqlite
# BDC_STORAGE_BACKEND=sqlite
# PC_STORAGE_BACKEND=sqlite
# OC_STORAGE_BACKEND=sqlite
# DDC_STORAGE_BACKEND=sqlite
# QDC_STORAGE_BACKEND=sqlite
# MC_STORAGE_BACKEND=sqlite
# DIC_PG_DATABASE=icdev_dic
# SLIDES_PG_DATABASE=icdev_slides
# OC_PG_DATABASE=icdev_observability

# ============================================================================
# DASHBOARD
# ============================================================================
# Auto-generated API key — run `python -c "import secrets; print('icdev_dash_' + secrets.token_hex(32))"` to rotate
ICDEV_DASHBOARD_API_KEY=
ICDEV_DASHBOARD_SECRET=change-me-in-production
ICDEV_DASHBOARD_HOST=127.0.0.1
# How a process ON THIS HOST reaches the dashboard. Read by the CLI bridge, the
# driverless CDP V&V harness, and (as `baseURL`) by playwright.config.ts.
#
# DO NOT set this to a container-to-host gateway name — `host.docker.internal`,
# `gateway.docker.internal`, `host.containers.internal`. Those resolve only
# meaningfully from INSIDE a container; on the host they either fail to resolve
# or resolve to an address the dashboard is not bound to (it binds
# ICDEV_DASHBOARD_HOST, 127.0.0.1 by default), so every connection TIMES OUT.
# That value in this variable made 43 of 45 E2E specs fail with
# net::ERR_CONNECTION_TIMED_OUT, one 30s navigationTimeout at a time
# (qa-fail-e2e-baseurl-01). A containerised agent should get the gateway value
# from the container's own environment, not from this file.
#
# To keep a non-local value here and still run the E2E suite, set the dedicated
# ICDEV_E2E_BASE_URL instead — playwright.config.ts prefers it.
ICDEV_DASHBOARD_URL=http://localhost:5050
ICDEV_CUI_BANNER_ENABLED=true
ICDEV_BYOK_ENABLED=false
ICDEV_CLI_BRIDGE=true
ICDEV_AUTO_COMMIT=false

# ---- Platform security gates ----
# CSRF protection for cookie-authenticated mutating JSON APIs (cnr-plat-01). ON
# by default; set to 0/false to disable. ICDEV_CSRF_GRACE=1 logs-but-allows
# during rollout.
ICDEV_CSRF_ENFORCE=true
# ICDEV_CSRF_GRACE=false
# Global upload cap in MB (cnr-plat-02). Flask returns a JSON 413 for larger
# request bodies before they are buffered into memory. Default 50.
ICDEV_MAX_UPLOAD_MB=50
# Canvas access control is FAIL-CLOSED by default (cnr-plat-03): unauthenticated
# canvas requests are redirected to login / 401'd. Set ICDEV_CANVAS_ACCESS_OPEN=true
# to allow unauthenticated access in local dev. ICDEV_AUTH_BYPASS=1 also opts out
# (test/CI). The legacy ICDEV_ENFORCE_CANVAS_ACCESS still works when set explicitly
# (true=enforce, false=open) and takes precedence, but is no longer required —
# enforcement is now the default.
# ICDEV_CANVAS_ACCESS_OPEN=false
# ICDEV_ENFORCE_CANVAS_ACCESS=

# ============================================================================
# CLASSIFICATION
# ============================================================================
# CUI // SP-CTI for IL4/IL5, SECRET for IL6
# Leave blank for UNCLASSIFIED
ICDEV_CLASSIFICATION=CUI
ICDEV_IMPACT_LEVEL=IL4

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# NOTIFICATIONS — Telegram (optional)
# ============================================================================
# Create a bot via @BotFather: https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

