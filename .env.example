# ============================================================================
# ICDEV — Intelligent Certified Development
# Environment Configuration Reference
# ============================================================================
# Copy to .env and edit values for your environment.
# All LLM model names, API keys, and routing config go here.
# No need to edit llm_config.yaml or Python code.
# ============================================================================

# ============================================================================
# LLM — Primary Local Model (Ollama)
# ============================================================================
# Ollama is the primary LLM. Free, local, air-gap safe.
# Install: https://ollama.com | Then: ollama pull qwen3.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# ============================================================================
# LLM — Cloud Providers (all optional)
# ============================================================================
# Leave blank to disable. Set API key to enable.

# --- Anthropic Claude ---
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Microsoft 365 / Graph API (Second Brain integrations — optional) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Email delivery (SMTP — optional, used if M365 not configured) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- AWS Bedrock ---
# Uses IAM credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or instance role)
AWS_DEFAULT_REGION=us-gov-west-1

# --- IBM watsonx.ai ---
IBM_CLOUD_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- vLLM (self-hosted) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

# ============================================================================
# LLM — Two-Tier Routing
# ============================================================================
# Ollama drafts, cloud LLM reviews. Set to false for Ollama-only mode.
LLM_TWO_TIER_ENABLED=true

# Confidence threshold — below this, LLM enhancement activates
LLM_CONFIDENCE_THRESHOLD=0.85

# ============================================================================
# RAG — Retrieval-Augmented Generation
# ============================================================================
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_VECTOR_STORE=auto

# ============================================================================
# FINE-TUNING
# ============================================================================
FINETUNE_ENABLED=true
FINETUNE_MIN_EXAMPLES=50
FINETUNE_BASE_MODEL=qwen3.5:latest

# ============================================================================
# DATABASE — PostgreSQL (required for container/production mode)
# ============================================================================
# Used by docker-compose.yml postgres service AND tools/db/storage.py when
# ICDEV_STORAGE_BACKEND=postgresql.
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(32))"
ICDEV_PG_PASSWORD=change-me-in-production
ICDEV_PG_USER=icdev
ICDEV_PG_DB=icdev
ICDEV_PG_HOST=localhost
ICDEV_PG_PORT=5432
ICDEV_STORAGE_BACKEND=sqlite
# Alpine/container image selector (debian-runtime or alpine-runtime)
# ICDEV_DOCKER_TARGET=debian-runtime

# ============================================================================
# DASHBOARD
# ============================================================================
ICDEV_DASHBOARD_SECRET=change-me-in-production
ICDEV_CUI_BANNER_ENABLED=true
ICDEV_BYOK_ENABLED=false

# ============================================================================
# CLASSIFICATION
# ============================================================================
# CUI // SP-CTI for IL4/IL5, SECRET for IL6
# Leave blank for UNCLASSIFIED
ICDEV_CLASSIFICATION=CUI
ICDEV_IMPACT_LEVEL=IL4

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# DESIGN CANVASES — All disabled by default. Enable via icdev-setup or manually.
# ============================================================================
ICDEV_IDC_ENABLED=false
ICDEV_NDC_ENABLED=false
ICDEV_SDC_ENABLED=false
ICDEV_BDC_ENABLED=false
ICDEV_PDC_ENABLED=false
ICDEV_ODC_ENABLED=false
ICDEV_DDC_ENABLED=false
ICDEV_QDC_ENABLED=false
ICDEV_MIGRATION_CANVAS_ENABLED=false
ICDEV_AIML_CANVAS_ENABLED=false
ICDEV_CANVAS_KG_ENABLED=false
ICDEV_MISSION_CANVAS_ENABLED=true

# ============================================================================
# CANVAS DATABASE — Storage backend for canvas databases
# ============================================================================
# Global fallback: all canvas init_db files use this unless per-canvas override set.
# ICDEV_CANVAS_STORAGE_BACKEND=sqlite
# Per-canvas overrides (uncomment to override global):
# IDC_STORAGE_BACKEND=sqlite
# NC_STORAGE_BACKEND=sqlite
# SC_STORAGE_BACKEND=sqlite
# BDC_STORAGE_BACKEND=sqlite
# PC_STORAGE_BACKEND=sqlite
# OC_STORAGE_BACKEND=sqlite
# DDC_STORAGE_BACKEND=sqlite
# QDC_STORAGE_BACKEND=sqlite
# MC_STORAGE_BACKEND=sqlite

# ============================================================================
# GOVCON / GovProposal / CPMP (disabled by default; opt-in only)
# ============================================================================
# Master switch for the GovCon Intelligence + GovProposal + CPMP modules
# (SAM.gov scanning, requirement extraction, capability mapping, proposal
# lifecycle, contract performance management). When false, the GovCon
# Python modules are never imported, the API blueprints aren't
# registered, the SSR pages don't exist, and the navigation menu hides
# the GovCon dropdown entirely.
#
# Forced OFF in air-gap mode (ICDEV_AIRGAP=true) regardless of this
# value, since GovCon depends on cloud / SAM.gov access.
ICDEV_GOVCON_ENABLED=false

# ============================================================================
# OPENCTI — Threat intelligence platform (disabled by default)
# ============================================================================
# Set OPENCTI_URL + OPENCTI_API_KEY and enable opencti.enabled in
# args/strategos_config.yaml to activate the OpenCTI integration.
OPENCTI_URL=https://your-opencti-instance.com
OPENCTI_API_KEY=your-api-key

# ============================================================================
# FILESYNC — File synchronization (disabled by default)
# ============================================================================
ICDEV_FILESYNC_ENABLED=false

# ============================================================================
# SIPA — Software Integrity & Provenance Assessor (tools/integrity/, /integrity)
# ============================================================================
# Static-only assessor that detects unauthorized/malicious code (human- or
# AI-introduced) not part of the original requirement/PRD. Quarantine-first
# with a HITL blocking gate. Behavior tuned in args/integrity_config.yaml.
ICDEV_INTEGRITY_ENABLED=true

# ============================================================================
# ACF — Autonomous Capability Foundry (disabled by default; opt-in autonomy)
# ============================================================================
# Master switch for the Foundry autonomous product factory.
# When false, the Foundry modules are never imported, the API blueprint
# isn't registered, and the Genesis scheduler won't spawn foundry tasks.
# Behavior tuned in args/foundry_config.yaml.
ICDEV_FOUNDRY_ENABLED=false

# ============================================================================
# FATHOMDESK — Secrets backend (Phase 2D, optional)
# ============================================================================
# Pluggable storage for per-user API credentials (Anthropic, OpenAI,
# Alpaca, etc.). Default is `local` — encrypted in the FathomDesk database
# via AES-GCM (keyed by ICDEV_KEYSTORE_KEY; users can additionally opt
# into per-user Path B vault mode for password-derived encryption).
#
# Switch to `vault` to delegate storage to HashiCorp Vault / OpenBao.
# When vault backend is active:
#   - Vault becomes the trust root — it encrypts + stores the secrets
#   - Path B (per-user vault mode) is inactive (Vault replaces it)
#   - Requires: pip install hvac (it's commented in requirements.txt)
#
# ICDEV_SECRET_BACKEND=local       # default
# ICDEV_SECRET_BACKEND=vault

# Required when ICDEV_SECRET_BACKEND=vault:
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=hvs.YOUR-VAULT-TOKEN-HERE   # raw token; AppRole / K8s / IAM auth are follow-ups
# VAULT_MOUNT_PATH=secret           # KV v2 mount path (default "secret")
# VAULT_NAMESPACE=                  # optional (Vault Enterprise namespace)
#
# Secrets land under: {mount}/data/fathomdesk/credentials/{user_id}/{provider}

# ============================================================================
# FATHOMDESK — Stripe billing (Phase 5B, optional)
# ============================================================================
# All three must be set for Checkout + Portal + webhooks to work.
# Omit entirely on air-gap / operator-managed deployments — /api/billing/tier
# direct-set path remains functional for manual tier assignment.
#
# Dashboards:
#   https://dashboard.stripe.com/apikeys            (secret + publishable)
#   https://dashboard.stripe.com/webhooks           (endpoint + signing secret)
#   https://dashboard.stripe.com/products           (create Prices → IDs below)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs per paid tier. Created once in Stripe Dashboard; copy IDs here.
# Resolved in this order: plan_tiers.yaml stripe_price_id → this env var.
# Free tier has no price. Enterprise may stay blank (contact-sales).
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Optional: public URLs for post-checkout redirects. Defaults to dashboard
# host; override if the dashboard is behind a reverse proxy.
# STRIPE_SUCCESS_URL=https://app.example.com/billing?checkout=success
# STRIPE_CANCEL_URL=https://app.example.com/billing?checkout=cancel
