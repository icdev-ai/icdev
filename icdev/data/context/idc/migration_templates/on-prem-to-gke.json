{
  "template_id": "idc-tpl-onprem-gke",
  "name": "On-Premises → Google GKE Migration",
  "description": "Infrastructure migration template: on-premises workloads to Google Kubernetes Engine Autopilot with Workload Identity, Cloud Armor, and Secret Manager",
  "source_platform": "on-premises",
  "target_platform": "gcp-gke",
  "nodes": [
    {
      "resource_id": "src-onprem",
      "label": "On-Premises Workloads",
      "resource_type": "on_premises",
      "platform": "on-premises",
      "properties": {"workload_types": ["containers", "vms", "bare-metal"]}
    },
    {
      "resource_id": "tgt-gke-cluster",
      "label": "GKE Autopilot Cluster",
      "resource_type": "gke_cluster",
      "platform": "gcp",
      "properties": {"mode": "autopilot", "region": "us-central1", "release_channel": "regular"}
    },
    {
      "resource_id": "tgt-workload-identity",
      "label": "GKE Workload Identity",
      "resource_type": "workload_identity",
      "platform": "gcp",
      "properties": {"service_account_binding": true}
    },
    {
      "resource_id": "tgt-cloud-armor",
      "label": "Cloud Armor + GCLB",
      "resource_type": "cloud_armor",
      "platform": "gcp",
      "properties": {"security_policy": "adaptive-protection", "ddos_protection": true}
    },
    {
      "resource_id": "tgt-secret-manager",
      "label": "GCP Secret Manager",
      "resource_type": "secret_manager",
      "platform": "gcp",
      "properties": {"csi_driver": "secrets-store-csi-driver-provider-gcp", "rotation_enabled": true}
    }
  ],
  "migration_steps": [
    "Create GKE Autopilot cluster with Workload Identity enabled",
    "Install GCP Secrets Store CSI provider",
    "Migrate secrets to GCP Secret Manager",
    "Map K8s service accounts to GCP service accounts via Workload Identity",
    "Deploy Cloud Armor and migrate Ingress to GCLB",
    "Validate workloads and cutover DNS"
  ],
  "sop_hints": ["kubernetes namespace", "k8s secrets", "eks fargate"]
}
