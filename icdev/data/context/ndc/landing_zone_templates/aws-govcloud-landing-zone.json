{
  "template_id": "ndc-tpl-aws-govcloud",
  "name": "AWS GovCloud Landing Zone",
  "description": "AWS GovCloud (US-East / US-West) VPC topology for IL4/IL5: FIPS endpoints, PrivateLink, GovCloud-only services, no public internet egress",
  "cloud_provider": "aws-govcloud",
  "topology_type": "landing_zone",
  "impact_level": "IL4",
  "classification": "CUI",
  "nodes": [
    {"node_id": "tgw-gov", "label": "GovCloud Transit Gateway", "node_type": "gateway", "properties": {"region": "us-gov-east-1", "asn": 64512}},
    {"node_id": "private-subnet-1a", "label": "Private Subnet AZ-1a", "node_type": "subnet", "properties": {"cidr": "10.100.1.0/24", "az": "us-gov-east-1a", "public": false}},
    {"node_id": "private-subnet-1b", "label": "Private Subnet AZ-1b", "node_type": "subnet", "properties": {"cidr": "10.100.2.0/24", "az": "us-gov-east-1b", "public": false}},
    {"node_id": "private-subnet-1c", "label": "Private Subnet AZ-1c", "node_type": "subnet", "properties": {"cidr": "10.100.3.0/24", "az": "us-gov-east-1c", "public": false}},
    {"node_id": "vpce-s3", "label": "VPC Endpoint — S3", "node_type": "endpoint", "properties": {"type": "Gateway", "fips": true}},
    {"node_id": "vpce-secretsmanager", "label": "VPC Endpoint — Secrets Manager", "node_type": "endpoint", "properties": {"type": "Interface", "fips": true}},
    {"node_id": "vpce-kms", "label": "VPC Endpoint — KMS", "node_type": "endpoint", "properties": {"type": "Interface", "fips": true}},
    {"node_id": "dx-gw", "label": "Direct Connect Gateway (GovCloud)", "node_type": "gateway", "properties": {"type": "DXGW", "connection": "dedicated", "speed": "10Gbps"}},
    {"node_id": "sipr-boundary", "label": "SIPR/SIPRNet Boundary (IL6 only)", "node_type": "external", "properties": {"optional": true, "il_level": "IL6", "type": "NSA-approved cross-domain"}}
  ],
  "edges": [
    {"source": "tgw-gov", "target": "private-subnet-1a", "edge_type": "attachment"},
    {"source": "tgw-gov", "target": "private-subnet-1b", "edge_type": "attachment"},
    {"source": "tgw-gov", "target": "private-subnet-1c", "edge_type": "attachment"},
    {"source": "private-subnet-1a", "target": "vpce-s3", "edge_type": "endpoint_route"},
    {"source": "private-subnet-1a", "target": "vpce-secretsmanager", "edge_type": "endpoint_route"},
    {"source": "private-subnet-1a", "target": "vpce-kms", "edge_type": "endpoint_route"},
    {"source": "dx-gw", "target": "tgw-gov", "edge_type": "peering"},
    {"source": "sipr-boundary", "target": "tgw-gov", "edge_type": "cross_domain", "label": "Type 1 encrypted XD solution"}
  ],
  "compliance": ["FedRAMP High", "NIST 800-53 Rev 5", "IL4/IL5 (AWS GovCloud)", "ITAR", "DoD CC SRG"],
  "security_controls": [
    "No public subnets — all traffic via PrivateLink or DX",
    "FIPS 140-2 endpoints enforced for all AWS services",
    "VPC Flow Logs → CloudWatch Logs (GovCloud)",
    "GuardDuty + Security Hub + Macie enabled",
    "CloudTrail with S3 + KMS encryption",
    "AWS Config rules for CUI boundary enforcement"
  ]
}
