# IQE-AIMC-007: AI compliance findings from the AI/ML Model Canvas
# IL-level compliance checks generated by AI — maps to FedRAMP AC-2
# (Account Management) and NIST AI RMF MANAGE 2.2 requirements.

foreach d in aimc.ai_decisions
where d.decision_type == "compliance_finding"
select d.record_id, d.decision, d.rationale, d.confidence, d.created_at
