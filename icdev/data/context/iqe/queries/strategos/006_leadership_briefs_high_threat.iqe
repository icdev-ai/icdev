# Intent: Find leadership briefs with HIGH or CRITICAL threat tier for immediate leadership attention.
# Expected: rows ordered by generated_at desc where threat_tier is HIGH or CRITICAL.

foreach b in strategos.leadership_briefs
  where b.threat_tier == "HIGH" or b.threat_tier == "CRITICAL"
  select b.id, b.theater, b.sio_composite_score, b.threat_tier, b.p_war_posterior, b.dti_score, b.generated_at
  order_by b.generated_at desc
  limit 10
