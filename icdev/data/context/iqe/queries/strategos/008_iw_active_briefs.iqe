# Intent: Find leadership briefs where information warfare activity was triggered.
# Expected: rows where iw_triggered == 1 indicating active IW activity in the data mesh.

foreach b in strategos.leadership_briefs
  where b.iw_triggered == 1
  select b.id, b.theater, b.threat_tier, b.goldstein_avg, b.signal_count_24h, b.generated_at
  order_by b.generated_at desc
  limit 20
