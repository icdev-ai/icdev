# Intent: Retrieve leadership briefs where the threat tier is HIGH or CRITICAL
#         and the 24h escalation probability is elevated, indicating near-term risk.
# Expected: rows showing theaters with current critical/high threat assessments
#   and their associated SIO composite scores and P(war) posteriors.

foreach b in strategos.leadership_briefs
  where b.threat_tier in ["HIGH", "CRITICAL"]
  select b.id, b.theater, b.threat_tier, b.sio_composite_score,
         b.p_war_posterior, b.signal_velocity, b.iw_triggered, b.generated_at
  order_by b.generated_at desc
  limit 10
