# PMC — Active peering sessions
# Canvas: pmc | Collection: pmc.peers
# Description: List all active BGP peers with traffic ratio and prefix counts

# Prompt: show active peers
# Prompt: show all active peering sessions
# Prompt: list active bgp peers with traffic ratio
# Prompt: which peers are active
# The lines above are paraphrases of ONE question for the NL widget. The IQE below
# is what the pmc adapter answers it with (tools/iqe/adapters/pmc.py).
foreach p in pmc.peers
where p.status == "active"
select p.id, p.asn, p.org_name, p.peer_type, p.policy, p.status, p.traffic_ratio, p.ipv4_prefix_count, p.ipv6_prefix_count, p.rir
# Presentation (IQE has no `order by`; the reader applies it): sort by p.org_name.
