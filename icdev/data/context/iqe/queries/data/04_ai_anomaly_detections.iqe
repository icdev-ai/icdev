# IQE-DDC-004: AI anomaly detections from the Data Design Canvas
# Filters to anomaly_detection decisions — maps to NIST AU-6 (Audit Review)
# and FedRAMP SI-4 information system monitoring requirements.

foreach d in data.ai_decisions
where d.decision_type == "anomaly_detection"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
