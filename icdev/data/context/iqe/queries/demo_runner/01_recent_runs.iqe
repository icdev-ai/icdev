// IQE-DR-001: Recent demo runs — last 10 runs with status and elapsed time
foreach r in demo_runner.runs
select r.run_id, r.audience, r.status, r.scenarios_passed, r.scenarios_total, r.elapsed_ms, r.created_at
# Not applied: IQE has no `order by` or `limit`, so the executor returns every matching row, unsorted and uncapped. Intended presentation, not performed: sort by r.created_at desc, keep the first 10 rows.
