# IQE-ODC-005: AI observability maturity assessments (ODC)
# Filters to compliance_finding decisions capturing maturity scores
# and MITRE ATT&CK coverage gaps identified by AI assessment.

foreach d in observability.ai_decisions
where d.decision_type == "compliance_finding"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
