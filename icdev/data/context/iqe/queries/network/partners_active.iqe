# collection: network.partners
# query: active peering partners agreement status
# description: All active partners with agreement status, ASN, and cross-connect counts
# tags: [partners, peering, active, agreements]
# network.partners is nc_partners (tools/iqe/adapters/ndc.py). Agreement status and
# cross-connect counts are not columns of it, so the query returns the partner fields
# that exist; network.agreements_expiring and ccc.xc_orders hold the rest.
foreach p in network.partners
where p.status == "active"
select p.id, p.name, p.partner_type, p.asn, p.status, p.contract_manager, p.noc_email
# Presentation (IQE has no `order by`; the reader applies it): sort by p.name.
