# collection: ccc.xc_orders
# query: partner cross-connect orders by facility
# description: Cross-connect orders grouped by partner and facility — Equinix, Megaport, Zayo, etc.
# tags: [orders, cross-connect, partner, facility]
# The IQE below is what the ccc adapter answers this prompt with (tools/iqe/adapters/ccc.py).
foreach o in ccc.xc_orders
where o.order_status != "not_ordered"
select o.id, o.xc_number, o.facility, o.order_status, o.partner_id, o.estimated_delivery
# Presentation (IQE has no `order by` or grouping; the reader applies it): group by o.partner_id, then o.facility; sort by o.estimated_delivery asc.
