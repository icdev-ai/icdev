# IQE-BDC-006: AI boundary impact assessments (BDC)
# Filters to boundary_impact decision type — maps to NIST CA-3
# (System Interconnections) and FedRAMP ISA requirements.

foreach d in bdc.ai_decisions
where d.decision_type == "boundary_impact"
select d.record_id, d.decision, d.rationale, d.model_used, d.confidence, d.trace_id
