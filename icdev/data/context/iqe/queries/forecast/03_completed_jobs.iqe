# IQE-FC-003: Completed forecast jobs
# Shows successfully completed forecasts with sample counts.

foreach j in forecast.jobs
where j.status == "completed"
select j.id, j.source, j.context, j.input_rows, j.model_id, j.completed_at
# Presentation (IQE has no `order by` or `limit`; the reader applies it): sort by j.completed_at desc, keep the first 50 rows.
