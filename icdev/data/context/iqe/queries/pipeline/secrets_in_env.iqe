# Intent: Detect pipeline nodes that inject secrets via plaintext environment
#         variables rather than a vault or secret-manager reference, exposing
#         credentials to any process that can read the process environment.
# Expected violation shape: rows where env_source == "plaintext";
#   each row is a pipeline node leaking secrets through the process environment.

foreach n in pipeline.nodes
  where n.env_source == "plaintext"
  select n.pipeline_id, n.snapshot_id, n.id, n.node_type, n.env_source
