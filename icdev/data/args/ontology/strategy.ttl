@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix core: <https://icdev.dev/ns/core#> .
@prefix strategy: <https://icdev.dev/ns/strategy#> .

<https://icdev.dev/ontology/strategy>
    rdf:type owl:Ontology ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "ICDEV STRATEGY Domain Ontology" ;
    dcterms:description "Class hierarchy for the strategy canvas domain." ;
    dcterms:date "2026-05-15"^^xsd:date .

strategy:WarCouncilBrief rdf:type owl:Class ;
    rdfs:label "War Council Brief" ;
    rdfs:subClassOf core:Concept .

strategy:AIROIFramework rdf:type owl:Class ;
    rdfs:label "AI ROI Framework" ;
    rdfs:subClassOf core:Concept .

strategy:GovernancePosture rdf:type owl:Class ;
    rdfs:label "Governance Posture" ;
    rdfs:subClassOf core:Concept .
