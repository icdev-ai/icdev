@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix core: <https://icdev.dev/ns/core#> .
@prefix security: <https://icdev.dev/ns/security#> .

<https://icdev.dev/ontology/security>
    rdf:type owl:Ontology ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "ICDEV SECURITY Domain Ontology" ;
    dcterms:description "Class hierarchy for the security canvas domain." ;
    dcterms:date "2026-05-15"^^xsd:date .

security:Classification rdf:type owl:Class ;
    rdfs:label "Classification" ;
    rdfs:subClassOf core:Concept .

security:SECRET rdf:type owl:Class ;
    rdfs:label "SECRET" ;
    rdfs:subClassOf security:Classification .

security:CUI rdf:type owl:Class ;
    rdfs:label "CUI" ;
    rdfs:subClassOf security:Classification .

security:Control rdf:type owl:Class ;
    rdfs:label "Security Control" ;
    rdfs:subClassOf core:Concept .

security:Boundary rdf:type owl:Class ;
    rdfs:label "Security Boundary" ;
    rdfs:subClassOf core:Resource .
