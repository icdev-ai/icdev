@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix core: <https://icdev.dev/ns/core#> .

<https://icdev.dev/ontology/core>
    rdf:type owl:Ontology ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "ICDEV CORE Domain Ontology" ;
    dcterms:description "Class hierarchy for the core canvas domain." ;
    dcterms:date "2026-05-15"^^xsd:date .

core:Resource rdf:type owl:Class ;
    rdfs:label "Resource" ;
    rdfs:subClassOf core:Entity .

core:Concept rdf:type owl:Class ;
    rdfs:label "Concept" ;
    rdfs:subClassOf core:Entity .

core:Entity rdf:type owl:Class ;
    rdfs:label "Entity" .

core:Design rdf:type owl:Class ;
    rdfs:label "Design" ;
    rdfs:subClassOf core:Entity .
