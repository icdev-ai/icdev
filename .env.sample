ICDEV_GOV_PROPOSAL_ENABLED=false       # GovProposal canvas
ICDEV_PROPOSAL_GENESIS_ENABLED=false   # Proposal Genesis
ICDEV_INNOVATION_ENABLED=false         # Innovation Engine
ICDEV_MARKETPLACE_ENABLED=false        # Asset Marketplace
ICDEV_NETWORK_ENABLED=false            # Network Intelligence Module
ICDEV_INTEGRITY_ENABLED=true           # SIPA — Software Integrity Assessor
