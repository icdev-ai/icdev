ICDEV_ADMIN_CONSOLE_ENABLED=false      # Admin Console
ICDEV_AI_OBSERVATORY_ENABLED=false     # AI Observatory
ICDEV_CACHE_SAVINGS_ENABLED=false      # Cache Savings dashboard
ICDEV_CAM_ENABLED=false                # Cloud Assessment Modeler
ICDEV_CPMP_ENABLED=false               # CPMP — Contract Performance Management Portal
ICDEV_FORECAST_ENABLED=true            # TimesFM Forecasting (enabled by default)
ICDEV_GOVLIFT_ENABLED=false            # GovLift
ICDEV_MC_ENABLED=false                 # Migration Canvas (legacy)
ICDEV_ONTOLOGY_ENABLED=false           # Ontology Explorer
ICDEV_SDC_DEMO_ENABLED=false           # Security Design Canvas demo content
ICDEV_SUPPLY_CHAIN_ENABLED=false       # Supply Chain Intelligence
ICDEV_AGENTS_IQE_ENABLED=false         # Agent Registry IQE
ICDEV_COMPLIANCE_IQE_ENABLED=false     # Compliance Core IQE
ICDEV_KANBAN_IQE_ENABLED=false         # Kanban Core IQE
ICDEV_PROJECTS_IQE_ENABLED=false       # Project Registry IQE

# Slides image generation
SLIDES_IMAGE_ENABLED=false
SLIDES_IMAGE_PROVIDER=dalle

# ============================================================================
# GOVCON / GovProposal / CPMP
# ============================================================================
# Forced OFF in air-gap mode (ICDEV_AIRGAP=true) regardless of this value.
# ICDEV_GOVCON_ENABLED=false (set above)

# SAM.gov API Key — register at https://sam.gov/content/entity-registration
SAM_GOV_API_KEY=your-sam-gov-api-key

# ============================================================================
# KANBAN — Task orchestration
# ============================================================================
ICDEV_KANBAN_EXECUTOR_CHAIN=claude_cli,gitlab,ollama_local
ICDEV_KANBAN_PR_FLOW=false

# ============================================================================
# GITHUB — CI/CD and kanban executor
# ============================================================================
# Generate at: https://github.com/settings/tokens (scopes: repo, workflow)
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_RUNNER_REPO=your-org/your-repo

# ============================================================================
# OPENCTI — Threat intelligence platform (optional)
# ============================================================================
OPENCTI_URL=https://your-opencti-instance.com
OPENCTI_API_KEY=your-opencti-api-key

# ============================================================================
# CARRIER / ISP APIs — Network canvas integrations (optional)
# ============================================================================
# Equinix ECX Fabric (cross-connects, virtual circuits)
# EQUINIX_ECX_CLIENT_ID=your-equinix-client-id
# EQUINIX_ECX_CLIENT_SECRET=your-equinix-client-secret

# Megaport (VXCs, ports, MCRs)
# MEGAPORT_USER=your-megaport-username
# MEGAPORT_PASS=your-megaport-password

# PeeringDB (PMC canvas — optional API key for higher rate limits)
# PEERINGDB_API_KEY=your-peeringdb-api-key

# ============================================================================
# PYPI PUBLISHING — Package distribution (maintainers only)
# ============================================================================
# Generate at: https://pypi.org/manage/account/token/
# PYPI_API_TOKEN=pypi-your-api-token
# TWINE_USERNAME=__token__
# TWINE_PASSWORD=pypi-your-api-token

# ============================================================================
# FATHOMDESK — Secrets backend (optional)
# ============================================================================
# ICDEV_SECRET_BACKEND=local   # default (AES-GCM encrypted in DB)
# ICDEV_SECRET_BACKEND=vault   # delegate to HashiCorp Vault / OpenBao

# Required when ICDEV_SECRET_BACKEND=vault:
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=hvs.YOUR-VAULT-TOKEN-HERE
# VAULT_MOUNT_PATH=secret
# VAULT_NAMESPACE=

# ============================================================================
# FATHOMDESK — Stripe billing (optional)
# ============================================================================
# All three required for Checkout + Portal + webhooks
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_ID_PRO=price_your-pro-price-id
STRIPE_PRICE_ID_ENTERPRISE=price_your-enterprise-price-id
# STRIPE_SUCCESS_URL=https://app.example.com/billing?checkout=success
# STRIPE_CANCEL_URL=https://app.example.com/billing?checkout=cancel
