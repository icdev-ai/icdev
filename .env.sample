ICDEV_GAMEDAY_ENABLED=false            # AI GameDay TTX
ICDEV_HITL_ENABLED=true                # Human-in-the-Loop gates
ICDEV_INFO_OPS_ENABLED=false           # Information Operations
ICDEV_INFRA_ENABLED=false              # Infrastructure tools
ICDEV_NOTIFICATIONS_ENABLED=false      # Push Notifications
