{
  "mcpServers": {
    "icdev-unified": {
      "command": "python",
      "args": [
        "tools/mcp/unified_server.py"
      ],
      "env": {
        "ICDEV_DB_PATH": "data/icdev.db",
        "ICDEV_PROJECT_ROOT": "."
      },
      "disabled": false
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {},
      "disabled": false
    }
  }
}