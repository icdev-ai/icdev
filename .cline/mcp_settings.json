{
  "mcpServers": {
    "icdev-unified": {
      "command": "python",
      "args": [
        "tools/mcp/unified_server.py"
      ],
      "env": {
        "ICDEV_DB_PATH": "data/icdev.db",
        "ICDEV_PROJECT_ROOT": "."
      },
      "disabled": false
    },
    "playwright": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--pull=never",
        "--add-host=host.docker.internal:host-gateway",
        "mcr.microsoft.com/playwright/mcp:latest",
        "--headless",
        "--isolated",
        "--caps=vision"
      ],
      "env": {},
      "disabled": false
    }
  }
}