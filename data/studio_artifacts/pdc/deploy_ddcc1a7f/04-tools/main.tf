# CUI // SP-CTI — Auto-generated by ICDEV™ Pipeline Design Canvas
# Layer 4: DevSecOps Tools — Helm Releases

provider "helm" {
  kubernetes {
    config_path = "~/.kube/config"
  }
}

resource "helm_release" "gitlab_runner" {
  name       = "gitlab-runner"
  repository = "https://charts.gitlab.io"
  chart      = "gitlab-runner"
  version    = "0.72.0"
  namespace  = "ci-cd"
  create_namespace = true

  values = [file("${path.module}/../values/gitlab-runner.yaml")]

  set {
    name  = "global.labels.project"
    value = "insecure-pipeline"
  }
}
