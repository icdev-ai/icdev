# Agentic AI Infrastructure — Generated by ICDEV™ AADC Workflow
# Generated: 2026-05-19T23:56:39Z
# DO NOT EDIT — regenerate via AADC Workflow
# CUI // SP-CTI

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.6.0"
}

locals {
  common_tags = {
    ManagedBy      = "icdev-aadc"
    Canvas         = "aadc"
    Environment    = var.environment
    Classification = "CUI"
  }
}

data "aws_caller_identity" "current" {}

# ── IAM — Lambda Execution Role ───────────────────────────────────────────────
resource "aws_iam_role" "agent_lambda" {
  name = "${var.environment}-aadc-agent-lambda-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
  tags = local.common_tags
}

resource "aws_iam_role_policy" "agent_lambda_policy" {
  name = "aadc-agent-policy"
  role = aws_iam_role.agent_lambda.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"]
        Resource = "${aws_cloudwatch_log_group.agent_logs.arn}:*"
      },
      {
        Effect   = "Allow"
        Action   = ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query"]
        Resource = aws_dynamodb_table.agent_state.arn
      },
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:PutObject"]
        Resource = ["${aws_s3_bucket.agent_artifacts.arn}", "${aws_s3_bucket.agent_artifacts.arn}/*"]
      },
      {
        Effect   = "Allow"
        Action   = ["ssm:GetParameter"]
        Resource = "arn:aws:ssm:*:*:parameter/aadc/*"
      }
    ]
  })
}

# ── Lambda — Agent Orchestrator ───────────────────────────────────────────────
resource "aws_lambda_function" "agent_orchestrator" {
  function_name = "${var.environment}-aadc-${var.agent_name}-orchestrator"
  role          = aws_iam_role.agent_lambda.arn
  handler       = "orchestrator.handler"
  runtime       = "python3.12"
  timeout       = 300
  memory_size   = 512

  environment {
    variables = {
      MODEL_ENDPOINT  = var.model_endpoint
      AGENT_NAME      = var.agent_name
      STATE_TABLE     = aws_dynamodb_table.agent_state.name
      LOG_GROUP       = aws_cloudwatch_log_group.agent_logs.name
    }
  }

  filename = "${path.module}/lambda/${var.agent_name}-orchestrator.zip"

  tags = local.common_tags
}

# ── Lambda — Input Validator / Guardrail ──────────────────────────────────────
resource "aws_lambda_function" "input_validator" {
  function_name = "${var.environment}-aadc-${var.agent_name}-guardrail"
  role          = aws_iam_role.agent_lambda.arn
  handler       = "guardrail.handler"
  runtime       = "python3.12"
  timeout       = 30
  memory_size   = 256

  environment {
    variables = {
      AGENT_NAME = var.agent_name
    }
  }

  filename = "${path.module}/lambda/${var.agent_name}-guardrail.zip"

  tags = local.common_tags
}

# ── API Gateway — Agent API Endpoint ─────────────────────────────────────────
resource "aws_api_gateway_rest_api" "agent_api" {
  name        = "${var.environment}-aadc-${var.agent_name}-api"
  description = "AADC agent API endpoint — ${var.agent_name}"
  tags        = local.common_tags
}

resource "aws_api_gateway_resource" "agent_resource" {
  rest_api_id = aws_api_gateway_rest_api.agent_api.id
  parent_id   = aws_api_gateway_rest_api.agent_api.root_resource_id
  path_part   = "invoke"
}

resource "aws_api_gateway_method" "agent_post" {
  rest_api_id   = aws_api_gateway_rest_api.agent_api.id
  resource_id   = aws_api_gateway_resource.agent_resource.id
  http_method   = "POST"
  authorization = "AWS_IAM"
}

resource "aws_api_gateway_integration" "agent_lambda" {
  rest_api_id             = aws_api_gateway_rest_api.agent_api.id
  resource_id             = aws_api_gateway_resource.agent_resource.id
  http_method             = aws_api_gateway_method.agent_post.http_method
  integration_http_method = "POST"
  type                    = "AWS_PROXY"
  uri                     = aws_lambda_function.agent_orchestrator.invoke_arn
}

resource "aws_api_gateway_stage" "dev" {
  deployment_id = aws_api_gateway_deployment.agent.id
  rest_api_id   = aws_api_gateway_rest_api.agent_api.id
  stage_name    = var.environment

  access_log_settings {
    destination_arn = aws_cloudwatch_log_group.agent_logs.arn
  }

  tags = local.common_tags
}

resource "aws_api_gateway_deployment" "agent" {
  rest_api_id = aws_api_gateway_rest_api.agent_api.id

  depends_on = [aws_api_gateway_integration.agent_lambda]

  lifecycle {
    create_before_destroy = true
  }
}

# ── S3 — Model Artifacts & Logs ───────────────────────────────────────────────
resource "aws_s3_bucket" "agent_artifacts" {
  bucket = "${var.environment}-aadc-${var.agent_name}-artifacts-${data.aws_caller_identity.current.account_id}"
  tags   = local.common_tags
}

resource "aws_s3_bucket_versioning" "agent_artifacts_ver" {
  bucket = aws_s3_bucket.agent_artifacts.id
  versioning_configuration { status = "Enabled" }
}

# ── DynamoDB — Agent State Store ─────────────────────────────────────────────
resource "aws_dynamodb_table" "agent_state" {
  name         = "${var.environment}-aadc-${var.agent_name}-state"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "session_id"
  range_key    = "timestamp"

  attribute {
    name = "session_id"
    type = "S"
  }
  attribute {
    name = "timestamp"
    type = "S"
  }

  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }

  tags = local.common_tags
}

# ── CloudWatch — Agent Execution Logs ─────────────────────────────────────────
resource "aws_cloudwatch_log_group" "agent_logs" {
  name              = "/aadc/${var.environment}/${var.agent_name}"
  retention_in_days = 90
  tags              = local.common_tags
}

# ── SSM — Model Endpoint Config ───────────────────────────────────────────────
resource "aws_ssm_parameter" "model_endpoint" {
  name        = "/aadc/${var.environment}/model_endpoint"
  type        = "String"
  value       = var.model_endpoint
  description = "AADC model endpoint configuration"
  tags        = local.common_tags
}
