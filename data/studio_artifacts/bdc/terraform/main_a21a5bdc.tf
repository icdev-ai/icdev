# Authorization Boundary Infrastructure — Generated by ICDEV™ BDC Workflow
# Canvas: bdc
# Generated: 2026-05-19T23:58:11Z
# DO NOT EDIT — regenerate via BDC Workflow
# Approval role: authorizing_official

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.6.0"
}

locals {
  common_tags = {
    ManagedBy       = "icdev-bdc"
    Canvas          = "bdc"
    Classification  = var.classification
    BoundaryName    = var.boundary_name
    Environment     = "gov"
  }
}

# ── VPC Endpoints (Private Access — no internet) ─────────────────────────────

resource "aws_vpc_endpoint" "s3_gateway" {
  vpc_id            = var.vpc_id
  service_name      = "com.amazonaws.${data.aws_region.current.name}.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = [aws_route_table.boundary_private.id]
  tags              = merge(local.common_tags, { Name = "icdev-boundary-s3-ep" })
}

resource "aws_vpc_endpoint" "ssm_interface" {
  vpc_id              = var.vpc_id
  service_name        = "com.amazonaws.${data.aws_region.current.name}.ssm"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = var.private_subnet_ids
  security_group_ids  = [aws_security_group.boundary_enforcement.id]
  private_dns_enabled = true
  tags                = merge(local.common_tags, { Name = "icdev-boundary-ssm-ep" })
}

resource "aws_vpc_endpoint" "kms_interface" {
  vpc_id              = var.vpc_id
  service_name        = "com.amazonaws.${data.aws_region.current.name}.kms"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = var.private_subnet_ids
  security_group_ids  = [aws_security_group.boundary_enforcement.id]
  private_dns_enabled = true
  tags                = merge(local.common_tags, { Name = "icdev-boundary-kms-ep" })
}

data "aws_region" "current" {}

# ── Route Table (for S3 gateway endpoint association) ────────────────────────

resource "aws_route_table" "boundary_private" {
  vpc_id = var.vpc_id
  tags   = merge(local.common_tags, { Name = "icdev-boundary-rt" })
}

# ── Network ACL — Boundary Enforcement ────────────────────────────────────────

resource "aws_network_acl" "boundary_enforcement" {
  vpc_id     = var.vpc_id
  subnet_ids = var.private_subnet_ids

  # Allow return traffic from established connections
  ingress {
    rule_no    = 100
    action     = "allow"
    protocol   = "tcp"
    cidr_block = "10.0.0.0/8"
    from_port  = 1024
    to_port    = 65535
  }

  # Allow HTTPS from private network
  ingress {
    rule_no    = 110
    action     = "allow"
    protocol   = "tcp"
    cidr_block = "10.0.0.0/8"
    from_port  = 443
    to_port    = 443
  }

  # Deny all other inbound from 0.0.0.0/0
  ingress {
    rule_no    = 32766
    action     = "deny"
    protocol   = "-1"
    cidr_block = "0.0.0.0/0"
    from_port  = 0
    to_port    = 0
  }

  egress {
    rule_no    = 100
    action     = "allow"
    protocol   = "-1"
    cidr_block = "0.0.0.0/0"
    from_port  = 0
    to_port    = 0
  }

  tags = merge(local.common_tags, { Name = "icdev-boundary-nacl" })
}

# ── Deny rule for sensitive ports from 0.0.0.0/0 ─────────────────────────────

resource "aws_network_acl_rule" "deny_rdp_inbound" {
  network_acl_id = aws_network_acl.boundary_enforcement.id
  rule_number    = 50
  egress         = false
  protocol       = "tcp"
  rule_action    = "deny"
  cidr_block     = "0.0.0.0/0"
  from_port      = 3389
  to_port        = 3389
}

resource "aws_network_acl_rule" "deny_ssh_inbound" {
  network_acl_id = aws_network_acl.boundary_enforcement.id
  rule_number    = 51
  egress         = false
  protocol       = "tcp"
  rule_action    = "deny"
  cidr_block     = "0.0.0.0/0"
  from_port      = 22
  to_port        = 22
}

# ── Security Group — Boundary Enforcement ─────────────────────────────────────

resource "aws_security_group" "boundary_enforcement" {
  name        = "icdev-boundary-enforcement-sg"
  description = "Boundary enforcement — interface endpoints only"
  vpc_id      = var.vpc_id

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/8"]
    description = "HTTPS from private network for VPC endpoint traffic"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "All outbound"
  }

  tags = merge(local.common_tags, { Name = "icdev-boundary-sg" })
}

# ── KMS — Boundary Data Encryption Key ───────────────────────────────────────

resource "aws_kms_key" "boundary_key" {
  description              = "ICDEV ${var.boundary_name} boundary encryption key (${var.classification})"
  deletion_window_in_days  = 30
  enable_key_rotation      = true
  multi_region             = false

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "Enable IAM User Permissions"
        Effect    = "Allow"
        Principal = { AWS = "arn:aws-us-gov:iam::${data.aws_caller_identity.current.account_id}:root" }
        Action    = "kms:*"
        Resource  = "*"
      }
    ]
  })

  tags = merge(local.common_tags, { Name = "icdev-boundary-cmk" })
}

data "aws_caller_identity" "current" {}

resource "aws_kms_alias" "boundary_key_alias" {
  name          = "alias/icdev-${var.boundary_name}-boundary"
  target_key_id = aws_kms_key.boundary_key.key_id
}

# ── SSM Parameter — Boundary Configuration ───────────────────────────────────

resource "aws_ssm_parameter" "boundary_config" {
  name   = "/icdev/boundary/${var.boundary_name}/config"
  type   = "SecureString"
  key_id = aws_kms_key.boundary_key.id
  value  = jsonencode({
    boundary_name    = var.boundary_name
    classification   = var.classification
    vpc_id           = var.vpc_id
    kms_key_arn      = aws_kms_key.boundary_key.arn
    s3_endpoint_id   = aws_vpc_endpoint.s3_gateway.id
    ssm_endpoint_id  = aws_vpc_endpoint.ssm_interface.id
    kms_endpoint_id  = aws_vpc_endpoint.kms_interface.id
  })
  tags = local.common_tags
}
