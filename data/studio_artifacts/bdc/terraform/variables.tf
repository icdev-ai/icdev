# variables.tf — Generated by ICDEV™ BDC Workflow

variable "vpc_id" {{
  type        = string
  description = "VPC ID where boundary controls are deployed"
}}

variable "private_subnet_ids" {{
  type        = list(string)
  description = "Private subnet IDs for interface VPC endpoints and NACL"
}}

variable "artifacts_bucket" {{
  type        = string
  description = "S3 bucket for Terraform state and artifacts"
}}

variable "db_password" {{
  type        = string
  description = "Database password (injected via TFVARS_DEFAULTS)"
  sensitive   = true
  default     = ""
}}

variable "dw_password" {{
  type        = string
  description = "Data warehouse password (injected via TFVARS_DEFAULTS)"
  sensitive   = true
  default     = ""
}}

variable "boundary_name" {{
  type        = string
  description = "Logical name for this authorization boundary"
  default     = "icdev-boundary"
}}

variable "classification" {{
  type        = string
  description = "Data classification level (CUI, SECRET, UNCLASSIFIED)"
  default     = "CUI"
  validation {{
    condition     = contains(["UNCLASSIFIED", "CUI", "SECRET", "TOP_SECRET"], var.classification)
    error_message = "classification must be UNCLASSIFIED, CUI, SECRET, or TOP_SECRET."
  }}
}}

variable "aws_region" {{
  type    = string
  default = "us-gov-west-1"
}}
