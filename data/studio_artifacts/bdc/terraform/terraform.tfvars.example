# terraform.tfvars.example — BDC Boundary Infrastructure
# Copy to terraform.tfvars and fill in real values before terraform apply

aws_region         = "us-gov-west-1"
vpc_id             = "vpc-xxxxxxxxxxxxxxxxx"
private_subnet_ids = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]
artifacts_bucket   = "icdev-boundary-artifacts-ACCOUNT_ID"
boundary_name      = "icdev-boundary"
classification     = "CUI"
# db_password and dw_password injected via CI/CD TFVARS_DEFAULTS
