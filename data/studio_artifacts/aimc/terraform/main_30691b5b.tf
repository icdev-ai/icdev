# AI/ML Infrastructure — Generated by ICDEV™ AIMC Workflow
# Generated: 2026-05-19T23:59:12Z
# DO NOT EDIT — regenerate via AIMC Workflow
# CUI // SP-CTI

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.6.0"
}

locals {
  common_tags = {
    ManagedBy      = "icdev-aimc"
    Canvas         = "aimc"
    Environment    = var.environment
    Classification = "CUI"
  }
}

data "aws_caller_identity" "current" {}

# ── IAM — SageMaker Execution Role ────────────────────────────────────────────
resource "aws_iam_role" "sagemaker_exec" {
  name = "${var.environment}-aimc-sagemaker-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "sagemaker.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
  tags = local.common_tags
}

resource "aws_iam_role_policy_attachment" "sagemaker_full" {
  role       = aws_iam_role.sagemaker_exec.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSageMakerFullAccess"
}

resource "aws_iam_role_policy" "sagemaker_s3" {
  name = "aimc-sagemaker-s3"
  role = aws_iam_role.sagemaker_exec.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"]
      Resource = ["${aws_s3_bucket.ml_artifacts.arn}", "${aws_s3_bucket.ml_artifacts.arn}/*"]
    }]
  })
}

# ── S3 — Model Artifacts & Datasets ──────────────────────────────────────────
resource "aws_s3_bucket" "ml_artifacts" {
  bucket = "${var.environment}-aimc-ml-artifacts-${data.aws_caller_identity.current.account_id}"
  tags   = local.common_tags
}

resource "aws_s3_bucket_versioning" "ml_artifacts_ver" {
  bucket = aws_s3_bucket.ml_artifacts.id
  versioning_configuration { status = "Enabled" }
}

# ── ECR — Model Training Images ───────────────────────────────────────────────
resource "aws_ecr_repository" "model_images" {
  name                 = "${var.environment}-aimc-model-images"
  image_tag_mutability = "IMMUTABLE"
  image_scanning_configuration { scan_on_push = true }
  tags = local.common_tags
}

# ── SageMaker — Domain (VpcOnly mode) ────────────────────────────────────────
resource "aws_sagemaker_domain" "ml_domain" {
  domain_name = var.sagemaker_domain_name
  auth_mode   = "IAM"
  vpc_id      = var.vpc_id
  subnet_ids  = var.private_subnet_ids

  default_user_settings {
    execution_role = aws_iam_role.sagemaker_exec.arn
  }

  app_network_access_type = "VpcOnly"
  tags = local.common_tags
}

# ── SageMaker — Versioned Model Resource ─────────────────────────────────────
resource "aws_sagemaker_model" "versioned_model" {
  name               = var.model_name
  execution_role_arn = aws_iam_role.sagemaker_exec.arn

  primary_container {
    image          = "${data.aws_caller_identity.current.account_id}.dkr.ecr.${var.aws_region}.amazonaws.com/${aws_ecr_repository.model_images.name}:latest"
    model_data_url = "s3://${aws_s3_bucket.ml_artifacts.bucket}/models/${var.model_name}/model.tar.gz"
  }

  tags = local.common_tags
}

# ── CloudWatch — Training & Inference Logs ────────────────────────────────────
resource "aws_cloudwatch_log_group" "ml_logs" {
  name              = "/aimc/${var.environment}/${var.sagemaker_domain_name}"
  retention_in_days = 90
  tags              = local.common_tags
}

# ── CloudWatch — Model Latency Alarm ─────────────────────────────────────────
resource "aws_cloudwatch_metric_alarm" "model_latency" {
  alarm_name          = "${var.environment}-aimc-model-latency-high"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 3
  metric_name         = "ModelLatency"
  namespace           = "AWS/SageMaker"
  period              = 60
  statistic           = "p90"
  threshold           = 500
  alarm_description   = "SageMaker model P90 latency exceeds 500ms SLA"
  tags                = local.common_tags
}

# ── SSM — Model Registry Config ───────────────────────────────────────────────
resource "aws_ssm_parameter" "model_registry_config" {
  name        = "/aimc/${var.environment}/model_registry"
  type        = "String"
  value       = jsonencode({
    domain_name = var.sagemaker_domain_name
    model_name  = var.model_name
    ecr_repo    = aws_ecr_repository.model_images.repository_url
    s3_bucket   = aws_s3_bucket.ml_artifacts.bucket
  })
  description = "AIMC model registry configuration"
  tags        = local.common_tags
}
