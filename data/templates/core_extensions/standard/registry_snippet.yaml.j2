# Paste this entry into args/component_registry.yaml under core_extensions:
# (auto-generated by icdev scaffold core {{ key }})
- key: {{ key }}
  kind: core_extension
  cli_name: {{ key | replace('_', '-') }}
  display_name: {{ display_name }}
  description: {{ description }}
  env_flag: {{ env_flag }}
  default_enabled: false
  module: {{ module_package }}.blueprint
  blueprint_attr: create_{{ key | replace('-', '_') }}_blueprint
  url_prefix: {{ url_prefix or '/' + key | replace('_', '-') }}
  min_il: {{ min_il }}
  default_roles:
{% for role in default_roles.split(',') %}
    - {{ role.strip() }}
{% endfor %}
  nav:
    section: System
    label: {{ display_name }}
