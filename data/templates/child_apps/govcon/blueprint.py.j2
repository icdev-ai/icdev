def create_{{ py_key }}_blueprint() -> Blueprint | None:
    if not _ENABLED:
        log.info("{{ display_name }} disabled via {{ env_flag }}=false")
        return None

    bp = Blueprint("{{ key }}", __name__, template_folder="../../tools/dashboard/templates")

    @bp.route("{{ url_prefix or '/' }}")
    def index():
        return render_template("{{ key }}/index.html")

    @bp.route("/api/opportunities")
    def api_opportunities():
        return jsonify({"opportunities": []})

    @bp.route("/api/proposals")
    def api_proposals():
        return jsonify({"proposals": []})

    @bp.route("/api/stats")
    def api_stats():
        return jsonify({
            "app": "{{ key }}",
            "display_name": "{{ display_name }}",
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "classification": "{{ classification }}",
        })

    global {{ py_key }}_bp
    {{ py_key }}_bp = bp
    return bp
