#!/usr/bin/env python3
# CUI // SP-CTI
"""Database initialization for {{ display_name }}."""

from __future__ import annotations

from pathlib import Path


def init_db(db_path: str | None = None) -> None:
    """Initialize the application database."""
    if db_path is None:
        db_path = str(Path(__file__).resolve().parent.parent.parent / "data" / "{{ key }}.db")

    data_dir = Path(db_path).parent
    data_dir.mkdir(parents=True, exist_ok=True)

    try:
        from tools.db.storage import get_connection
        conn = get_connection(db_path)
    except Exception:
        import sqlite3
        conn = sqlite3.connect(db_path)

    conn.execute(
        "CREATE TABLE IF NOT EXISTS projects ("
        "id TEXT PRIMARY KEY, name TEXT, status TEXT DEFAULT 'active', "
        "created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)"
    )
    conn.execute(
        "CREATE TABLE IF NOT EXISTS audit_trail ("
        "id TEXT PRIMARY KEY, event_type TEXT, action TEXT, "
        "created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)"
    )
    conn.commit()

    tables = [r[0] for r in conn.execute(
        "SELECT name FROM sqlite_master WHERE type='table'"
    ).fetchall()]
    print(f"{{ display_name }} database initialized at {db_path}")
    print(f"Tables created ({len(tables)}): {', '.join(sorted(tables))}")
    conn.close()


if __name__ == "__main__":
    init_db()
