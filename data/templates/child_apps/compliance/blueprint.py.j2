from __future__ import annotations

import os
from datetime import datetime, timezone

from flask import Blueprint, jsonify, render_template

from tools.logging.icdev_logger import get_logger

log = get_logger(__name__)

_ENABLED = os.environ.get("{{ env_flag }}", "false").lower() in ("true", "1", "yes")

{% set py_key = key | replace('-', '_') %}

{{ py_key }}_bp: Blueprint | None = None


def create_{{ py_key }}_blueprint() -> Blueprint | None:
    if not _ENABLED:
        log.info("{{ display_name }} disabled via {{ env_flag }}=false")
        return None

    bp = Blueprint("{{ key }}", __name__, template_folder="../../tools/dashboard/templates")

    @bp.route("{{ url_prefix or '/' }}")
    def index():
        return render_template("{{ key }}/index.html")

    @bp.route("/api/ssp")
    def api_ssp():
        return jsonify({"controls": [], "status": "draft", "classification": "{{ classification }}"})

    @bp.route("/api/poam")
    def api_poam():
        return jsonify({"items": [], "status": "draft"})

    @bp.route("/api/stats")
    def api_stats():
        return jsonify({
            "app": "{{ key }}",
            "display_name": "{{ display_name }}",
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "classification": "{{ classification }}",
        })

    global {{ py_key }}_bp
    {{ py_key }}_bp = bp
    return bp
