# CUI // SP-CTI
# {{ display_name }}: the service's declaration. Generated by the golden path `{{ path_id }}` {{ path_version }}.
# The scorecard declaration: the component-readiness scorecard grades the registry entry
# (args/component_registry.yaml key {{ key }}); the standards below are what the path declared when this
# service was scaffolded, and the drift check scored. Keep it with the service.
service: {{ key }}
display_name: {{ display_name }}
golden_path: {id: {{ path_id }}, version: "{{ path_version }}"}
scorecard: {key: component-readiness, entity: {{ key }}}
owner: {{ owner }}
feature: {{ key }}.service
standards: [{% for s in standards.split(',') if s %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}]
contract: tools/{{ key }}/contract.openapi.yaml
control_map: tools/{{ key }}/control_map.yaml
sbom: tools/{{ key }}/bom/sbom.cdx.json
{%- if uses_model %}
ai_bom: tools/{{ key }}/bom/ai-bom.json
{%- endif %}
adr: D-{{ key_upper }}-1
workflow: decl-wft-{{ key | replace('_', '-') }}-decide
twin: {canvas: {{ key }}, observes: [{{ key }}.service]}
requirements: [PM-{{ key_upper }}-01, PM-{{ key_upper }}-02]
mcp_tools: [{{ key }}_items, {{ key }}_propose]
otel_service: icdev.{{ key }}
