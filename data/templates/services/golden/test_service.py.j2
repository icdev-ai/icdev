from __future__ import annotations

import pytest
from flask import Flask, g

PROPOSER = {"id": "u-{{ key }}-proposer", "role": "reviewer"}
DECIDER = {"id": "u-{{ key }}-decider", "role": "reviewer"}
AGENT = {"id": "agent:{{ key }}-drafter", "role": "service"}


def _client(user, monkeypatch):
    monkeypatch.setenv("{{ env_flag }}", "true")
    from tools.{{ key }}.blueprint import create_{{ key }}_blueprint

    app = Flask(__name__)
    app.config["TESTING"] = True

    @app.before_request
    def _auth():
        g.current_user = dict(user)

    app.register_blueprint(create_{{ key }}_blueprint(), url_prefix="{{ url_prefix }}")
    return app.test_client()


def test_a_proposal_decides_nothing_and_the_proposer_never_decides_it(wf_db):
    from tools.{{ key }} import service

    out = service.propose("First item (synthetic)", "a note", actor=PROPOSER)
    assert out["status"] == "pending" and out["proposed_by"] == PROPOSER["id"]
    with pytest.raises(service.Refused) as own:
        service.decide(out["step_id"], decision="approve", reason="mine", actor=PROPOSER)
    assert own.value.status == 403
    done = service.decide(out["step_id"], decision="approve", reason="Read it (synthetic).", actor=DECIDER)
    assert done["affirmative"] is True and done["decided_by"] == DECIDER["id"]
    [row] = [s for s in service.items() if s["step_id"] == out["step_id"]]
    assert row["status"] == "decided" and row["decided_by"] == DECIDER["id"]


def test_an_agent_only_proposes_and_a_title_is_required(wf_db):
    from tools.{{ key }} import service

    out = service.propose("Drafted by an agent (synthetic)", actor=AGENT)
    assert out["status"] == "pending"
    with pytest.raises(service.Refused) as refused:
        service.decide(out["step_id"], decision="approve", reason="an agent", actor=AGENT)
    assert refused.value.status == 403, "a service key never takes the step"
    with pytest.raises(service.Refused):
        service.propose("   ", actor=PROPOSER)
    with pytest.raises(service.Refused):
        service.propose("no actor", actor=None)


def test_the_routes_read_propose_and_refuse_the_proposer(wf_db, monkeypatch):
    prop, dec = _client(PROPOSER, monkeypatch), _client(DECIDER, monkeypatch)
    r = prop.post("{{ url_prefix }}/api/propose", json={"title": "Through the route (synthetic)"})
    assert r.status_code == 201, r.get_data(as_text=True)
    step = r.get_json()["step_id"]
    assert step in [s["step_id"] for s in prop.get("{{ url_prefix }}/api/items").get_json()["items"]]
    body = {"step_id": step, "decision": "reject", "reason": "Not needed (synthetic)."}
    assert prop.post("{{ url_prefix }}/api/decide", json=body).status_code == 403
    assert dec.post("{{ url_prefix }}/api/decide", json=body).get_json()["decision"] == "reject"


def test_the_twin_judges_with_threads_and_unread_is_unverified():
    from tools.twin_core.adapters.{{ key }} import {{ key | replace('_', ' ') | title | replace(' ', '') }}Twin

    twin = {{ key | replace('_', ' ') | title | replace(' ', '') }}Twin()
    ev = {"observed_at": "2026-02-01T00:00:00+00:00", "policy": {"waiting_warn_days": 7}, "service": {
        "items": [{"step_id": "step-old", "status": "pending", "proposed_by": "a", "decided_by": "",
                   "decision": "", "updated_at": "2026-01-01T00:00:00+00:00"},
                  {"step_id": "step-self", "status": "decided", "proposed_by": "a", "decided_by": "a",
                   "decision": "approve", "updated_at": "2026-01-02T00:00:00+00:00"}], "errors": {}}}
    out = twin.judge(ev)
    assert out["checks"][0]["status"] == "verified" and out["summary"]["pending"] == 1
    assert {f["rule_id"]: f["thread_id"] for f in out["findings"]} == {
        "{{ key }}.service.waiting": "wf_step:step-old", "{{ key }}.service.self_decided": "wf_step:step-self"}
    out = twin.judge({**ev, "service": {"items": None, "errors": {"ledger": "down"}}})
    assert out["checks"][0]["status"] == "unverified" and not out["findings"]


