# CUI // SP-CTI
"""{{ display_name }}: MCP tools. Generated by the golden path `{{ path_id }}` {{ path_version }}.

Registered in tools/mcp/tool_registry.py (RESOURCE_REGISTRY and READ_ONLY_DECLARATIONS) by the
scaffold's registration step. ``{{ key }}_items`` reads; ``{{ key }}_propose`` records a proposal as the
agent's draft (``agent:<name>``) and decides nothing, so it is not read-only and halts at the
approval gate. No tool decides: a person decides on the page.
"""
from __future__ import annotations


def handle_{{ key }}_items(args: dict) -> dict:
    """Every proposal of {{ display_name }} and its state."""
    from tools.{{ key }} import service

    return {"items": service.items(int((args or {}).get("limit") or 100))}


def handle_{{ key }}_propose(args: dict) -> dict:
    """A proposal, recorded as the agent's draft. Decides nothing."""
    from tools.{{ key }} import service

    args = args or {}
    agent = str(args.get("agent_id") or "mcp").strip() or "mcp"
    try:
        return service.propose(str(args.get("title") or ""), str(args.get("note") or ""),
                               actor={"id": f"agent:{agent}", "role": "service"})
    except service.Refused as exc:
        return exc.to_dict()
