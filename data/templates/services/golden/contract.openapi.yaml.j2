# CUI // SP-CTI
# {{ display_name }}: the service's contract (OpenAPI 3.1). Generated by the golden path `{{ path_id }}`
# {{ path_version }}. The routes are named by endpoint id on the page (routes.gen.js); this is what a
# client may rely on. A breaking change is a new major version of this file.
openapi: 3.1.0
info:
  title: {{ display_name }}
  version: 1.0.0
  description: Proposals a person decides through the declared workflow decl-wft-{{ key | replace('_', '-') }}-decide.
paths:
  {{ url_prefix }}/api/items:
    get:
      operationId: {{ key }}.{{ key }}_api_items
      summary: Every proposal and its state (read)
      responses:
        "200": {description: "{items: [...], template}"}
        "503": {description: the ledger could not be read}
  {{ url_prefix }}/api/propose:
    post:
      operationId: {{ key }}.{{ key }}_api_propose
      summary: A proposal (decides nothing)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [title]
              properties:
                title: {type: string, maxLength: 200}
                note: {type: string}
      responses:
        "201": {description: the proposal, pending a person}
        "400": {description: invalid}
        "401": {description: no signed-in person or named agent}
  {{ url_prefix }}/api/decide:
    post:
      operationId: {{ key }}.{{ key }}_api_decide
      summary: A person who did not propose it decides (declared step)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [step_id, decision, reason]
              properties:
                step_id: {type: string}
                decision: {type: string, enum: [approve, reject]}
                reason: {type: string}
      responses:
        "200": {description: the decided step}
        "403": {description: refused (the proposer, a service key, or a role that does not hold the step)}
        "409": {description: already decided}
