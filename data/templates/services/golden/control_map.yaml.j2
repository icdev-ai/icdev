# CUI // SP-CTI
# {{ display_name }}: control map. Generated by the golden path `{{ path_id }}` {{ path_version }}.
# Each control the service helps implement, and the code or test that is its evidence. A mapping,
# never a claim of compliance: the crosswalk engine and the assessors judge.
service: {{ key }}
controls:
  - {id: AC-3, evidence: "tools/{{ key }}/blueprint.py (dashboard auth; the step's holders)", test: "tests/test_{{ key }}.py"}
  - {id: AC-5, evidence: "args/workflow_hitl_templates/{{ key | replace('_', '-') }}-decide.yaml (separate_from: proposer)", test: "tests/test_{{ key }}.py"}
  - {id: AU-2, evidence: "wf_decision_steps (every proposal and decision, append-only)", test: "tests/test_{{ key }}.py"}
  - {id: AU-12, evidence: "tools/{{ key }}/telemetry.py (a span per route and call)", test: "tests/test_{{ key }}.py"}
  - {id: CM-3, evidence: "the declared workflow; nothing advances by itself", test: "tests/test_{{ key }}.py"}
  - {id: SA-11, evidence: "tests/test_{{ key }}.py and tests/e2e/{{ key }}.spec.ts", test: "tests/test_{{ key }}.py"}
  - {id: SI-4, evidence: "tools/twin_core/adapters/{{ key }}.py (findings with threads)", test: "tests/test_{{ key }}.py"}
