# CUI // SP-CTI
"""{{ display_name }}: Flask blueprint. Generated by the golden path `{{ path_id }}` {{ path_version }}.

Mounted at ``{{ url_prefix }}`` by tools/dashboard/app.py from args/component_registry.yaml; the blueprint
declares no prefix of its own. Every route runs inside an OTel span (telemetry.py).

  GET  {{ url_prefix }}/                    The page: proposals, the propose form, the decision step
  GET  {{ url_prefix }}/api/items           JSON: every proposal and its state (read)
  POST {{ url_prefix }}/api/propose         A proposal (anyone, or an agent; decides nothing)
  POST {{ url_prefix }}/api/decide          A person who did not propose it decides (declared step)
"""
from __future__ import annotations

import os

from flask import Blueprint, jsonify, render_template, request as flask_request

from tools.{{ key }} import service
from tools.{{ key }}.constants import DISPLAY_NAME, TEMPLATE
from tools.{{ key }}.telemetry import span

_ENABLED_VALUES = ("true", "1", "yes")


def create_{{ key }}_blueprint() -> Blueprint | None:
    if os.environ.get("{{ env_flag }}", "false").lower() not in _ENABLED_VALUES:
        return None

    bp = Blueprint("{{ key }}", __name__, template_folder="../../tools/dashboard/templates")

    def _body() -> dict:
        data = flask_request.get_json(silent=True)
        return data if isinstance(data, dict) else {}

    def _refused(exc: service.Refused):
        return jsonify(exc.to_dict()), exc.status

    @bp.route("/")
    def {{ key }}_page():
        """{{ display_name }}: every proposal, the propose form and the step a person takes."""
        with span("page"):
            return render_template("{{ key }}/page.html", display_name=DISPLAY_NAME, template=TEMPLATE)

    @bp.route("/api/items")
    def {{ key }}_api_items():
        """JSON: every proposal of this service and its state."""
        with span("api.items"):
            try:
                return jsonify({"items": service.items(), "template": TEMPLATE})
            except Exception as exc:  # noqa: BLE001 — an unreadable ledger is said, never an empty list
                return jsonify({"error": f"the proposals could not be read: {exc}"}), 503

    @bp.route("/api/propose", methods=["POST"])
    def {{ key }}_api_propose():
        """A proposal: anyone signed in, or an agent. It decides nothing."""
        from tools.workflow_hitl.declared import current_actor

        data = _body()
        with span("api.propose"):
            try:
                return jsonify(service.propose(str(data.get("title") or ""), str(data.get("note") or ""),
                                               actor=current_actor())), 201
            except service.Refused as exc:
                return _refused(exc)

    @bp.route("/api/decide", methods=["POST"])
    def {{ key }}_api_decide():
        """A person who did not propose it approves or rejects a proposal, with a reason (declared step)."""
        from tools.workflow_hitl.declared import current_actor

        data = _body()
        with span("api.decide"):
            try:
                return jsonify(service.decide(str(data.get("step_id") or ""), decision=str(data.get("decision") or ""),
                                              reason=str(data.get("reason") or ""), actor=current_actor()))
            except service.Refused as exc:
                return _refused(exc)

    return bp
