# CUI // SP-CTI
# ICDEV platform model: {{ display_name }}. Generated by the golden path `{{ path_id }}` {{ path_version }}.
# requirement -> element -> code -> test (-> NIST control). Rules: the header of
# args/platform_model/cortex.yaml.

component: {{ key }}
project_id: icdev-platform

elements:
  - id: {{ key }}.service
    type: sysml_element
    kind: block
    name: {{ display_name }} (proposals a person decides)
    features: [{{ key }}.service]
    code:
      - tools/{{ key }}/service.py::propose
      - tools/{{ key }}/service.py::decide
      - tools/{{ key }}/service.py::items
      - args/workflow_hitl_templates/{{ key | replace('_', '-') }}-decide.yaml

  - id: {{ key }}.twin
    type: sysml_element
    kind: block
    name: {{ display_name }} governance twin
    features: [{{ key }}.service]
    code:
      - tools/{{ key }}/service.py::twin_evidence
      - tools/twin_core/adapters/{{ key }}.py

interfaces:
  - id: if.{{ key }}.console
    type: sysml_element
    kind: interface_block
    name: Console {{ url_prefix }}/ and its routes (contract tools/{{ key }}/contract.openapi.yaml)
    features: [{{ key }}.service]
    code:
      - tools/dashboard/templates/{{ key }}/page.html
      - tools/{{ key }}/blueprint.py::create_{{ key }}_blueprint
      - tools/{{ key }}/contract.openapi.yaml

  - id: if.{{ key }}.mcp
    type: sysml_element
    kind: interface_block
    name: MCP read and propose for {{ display_name }}
    features: [{{ key }}.service]
    code:
      - tools/{{ key }}/mcp_tools.py::handle_{{ key }}_items
      - tools/{{ key }}/mcp_tools.py::handle_{{ key }}_propose

requirements:
  - id: PM-{{ key_upper }}-01
    title: A proposal decides nothing, and a person who did not propose it decides it
    text: >-
      Anyone signed in, or an agent, proposes; the proposal is a pending step of
      decl-wft-{{ key | replace('_', '-') }}-decide. A person who holds the step and did not propose it
      approves or rejects it, with a reason; the proposer and a service key are refused.
    type: functional
    priority: high
    features: [{{ key }}.service]
    elements: [{{ key }}.service]
    controls: [AC-5, AU-2]
    tests:
      - tests/test_{{ key }}.py::test_a_proposal_decides_nothing_and_the_proposer_never_decides_it
      - tests/test_{{ key }}.py::test_an_agent_only_proposes_and_a_title_is_required

  - id: PM-{{ key_upper }}-02
    title: The page, the twin with threads, and MCP read and propose
    text: >-
      {{ url_prefix }}/ lists the proposals and offers the step by endpoint id. The twin observes
      {{ key }}.service: a long wait or a self-decided proposal is a finding threaded to its step, and an
      unreadable ledger is unverified. MCP {{ key }}_items reads; {{ key }}_propose only drafts.
    type: functional
    priority: medium
    features: [{{ key }}.service]
    elements: [if.{{ key }}.console, {{ key }}.twin, if.{{ key }}.mcp]
    controls: [AU-6, SI-4]
    tests:
      - tests/test_{{ key }}.py::test_the_routes_read_propose_and_refuse_the_proposer
      - tests/test_{{ key }}.py::test_the_twin_judges_with_threads_and_unread_is_unverified
      - tests/test_{{ key }}.py::test_the_mcp_tools_read_and_only_propose
