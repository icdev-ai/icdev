# CUI // SP-CTI
"""{{ display_name }}: the backing module. Generated by the golden path `{{ path_id }}` {{ path_version }}.

What this service does, in the shape every ICDEV service keeps:

* anyone signed in, or an agent, PROPOSES an item (:func:`propose`); a proposal decides nothing;
* a person who did not propose it DECIDES it (:func:`decide`), through the declared workflow
  ``decl-wft-{{ key | replace('_', '-') }}-decide`` (separate_from: proposer), with a reason;
* every proposal and decision is a row of ``wf_decision_steps``, append-only: there is no other
  store to fall out of step with, and nothing advances by itself;
* the twin (tools/twin_core/adapters/{{ key }}.py) reads the same rows through :func:`twin_evidence`
  and judges them purely, so an observation replays.
{%- if uses_model %}

A model may DRAFT a proposal's note (:func:`draft_note`), through the governed router by its
``llm_function`` and never by a model id. A draft is labelled as one and decides nothing.
{%- endif %}
"""
from __future__ import annotations

from typing import Any, Optional

from tools.{{ key }}.constants import FEATURE, MAX_TITLE, SURFACE, TEMPLATE
from tools.{{ key }}.telemetry import span


class Refused(Exception):
    """The request is refused. ``status`` is the HTTP status a route returns."""

    def __init__(self, status: int, code: str, message: str):
        self.status, self.code, self.message = status, code, message
        super().__init__(message)

    def to_dict(self) -> dict:
        return {"error": self.message, "code": self.code, "refused": True}


def _text(value: Any) -> str:
    return str(value if value is not None else "").strip()


def items(limit: int = 100) -> list[dict]:
    """Every proposal of this service, newest first, with its state from the ledger."""
    from tools.workflow_hitl import declared

    with span("items"):
        return [s for s in declared.list_steps(limit=2000) if s.get("template_id") == TEMPLATE][:limit]


def propose(title: str, note: str = "", actor: Optional[dict] = None) -> dict:
    """Record a proposal for a person to decide. Anyone signed in, or an agent. Decides nothing."""
    from tools.workflow_hitl import declared

    if not isinstance(actor, dict) or not _text(actor.get("id")):
        raise Refused(401, "no_actor", "a proposal needs a signed-in person or a named agent")
    title = " ".join(_text(title).split())
    if not title or len(title) > MAX_TITLE:
        raise Refused(400, "invalid", f"a title of 1 to {MAX_TITLE} characters is required")
    with span("propose"):
        try:
            out = declared.propose(TEMPLATE, surface=SURFACE, subject=f"{FEATURE}:{title}",
                                   payload={"title": title}, actor=actor, note=_text(note))
        except declared.StepRefused as exc:
            raise Refused(exc.status, exc.code, exc.message) from exc
    return {**out, "title": title, "proposed_by": actor["id"]}


def decide(step_id: str, *, decision: str, reason: str, actor: Optional[dict]) -> dict:
    """A person who did not propose it approves or rejects a proposal (the declared step)."""
    from tools.workflow_hitl import declared

    if not isinstance(actor, dict):
        raise Refused(401, "no_person", "a decision is a signed-in person's declared step")
    with span("decide", decision=_text(decision)):
        try:
            return declared.decide(_text(step_id), decision=_text(decision).lower(),
                                   reason=_text(reason), actor=actor)
        except declared.StepRefused as exc:
            raise Refused(exc.status, exc.code, exc.message) from exc
{%- if uses_model %}


def draft_note(text: str) -> dict:
    """A model's draft of a proposal's note, through the governed router. Decides nothing.

    Returns ``{"draft", "label"}``; when no model answers, ``draft`` is empty and ``why`` says so.
    """
    from tools.{{ key }}.constants import LLM_FUNCTION

    with span("draft"):
        try:
            from tools.llm.router import LLMRequest, LLMRouter

            req = LLMRequest(function=LLM_FUNCTION, system="Draft a short, factual note.",
                             prompt=_text(text)[:2000], max_tokens=256)
            resp = LLMRouter().invoke(LLM_FUNCTION, req)
            body = _text(getattr(resp, "content", None) or getattr(resp, "text", None))
            return {"draft": body, "label": "model draft (a proposal, not a decision)"}
        except Exception as exc:  # noqa: BLE001 — no model is an empty draft, said, never a guess
            return {"draft": "", "label": "no draft", "why": f"no model answered: {exc}"}
{%- endif %}


# ── the twin's evidence and judgement ─────────────────────────────────────────


def twin_evidence() -> dict:
    """What the governance twin reads: every proposal and its state. Never raises."""
    ev: dict[str, Any] = {"items": None, "errors": {}}
    try:
        ev["items"] = [{k: s.get(k) for k in ("step_id", "status", "proposed_by", "decided_by",
                                               "decision", "updated_at")} for s in items(500)]
    except Exception as exc:  # noqa: BLE001 — unreadable is unverified
        ev["errors"]["ledger"] = str(exc)
    return ev

