# CUI // SP-CTI
"""{{ display_name }}: constants. Generated by the golden path `{{ path_id }}` {{ path_version }}."""

SERVICE_KEY = "{{ key }}"
DISPLAY_NAME = "{{ display_name }}"
CLASSIFICATION = "CUI // SP-CTI"

#: The declared workflow for the one decision this service asks of a person
#: (args/workflow_hitl_templates/{{ key | replace('_', '-') }}-decide.yaml).
TEMPLATE = "decl-wft-{{ key | replace('_', '-') }}-decide"
#: The route that takes the decision (blueprint endpoint id).
SURFACE = "{{ key }}.{{ key }}_api_decide"

#: The feature key the five-rules audit and the twin know this service by.
FEATURE = "{{ key }}.service"

#: A proposal waiting longer than this for a person is a twin finding.
WAITING_WARN_DAYS = 7

#: A proposal's title, bounded.
MAX_TITLE = 200

#: The OTel service name and span prefix (tools/{{ key }}/telemetry.py).
OTEL_SERVICE = "icdev.{{ key }}"
{%- if uses_model %}

#: The router function a draft is asked of (args/llm_config.yaml routing). Never a model id.
LLM_FUNCTION = "{{ key }}_draft"
{%- endif %}
