# CUI // SP-CTI
# {{ display_name }}: the one decision this service asks of a person. Generated by the golden path
# `{{ path_id }}` {{ path_version }}.
id: decl-wft-{{ key | replace('_', '-') }}-decide
name: "{{ display_name }}: a person who did not propose it approves or rejects a proposal (propose -> decide)"
description: >-
  Anyone signed in, or an agent, proposes an item on {{ url_prefix }}/; a proposal decides nothing.
  A person who did not propose it approves or rejects it, with a reason. Nothing advances by itself.
decides: [{{ key }}.{{ key }}_api_decide]
effect: >-
  The decided step in wf_decision_steps is the decision (subject "{{ key }}.service:<title>"); the
  service has no other store.
approval_policy: any_one
kickback_limit: 1
stages:
  - name: propose
    step_type: automated
    description: Someone (a person, or an agent's draft) proposed an item.
  - name: decide
    step_type: manual
    role: {{ key }}_decider
    holders: [admin, isso, reviewer]
    # The person who proposed it never decides it.
    separate_from: proposer
    decisions: {approve: affirm, reject: deny}
    reason_required: [approve, reject]
