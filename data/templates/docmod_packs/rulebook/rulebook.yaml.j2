# CUI // SP-CTI
# {{ display_name }} rulebook — the deterministic evidence for this domain.
# Generated by: icdev scaffold docmod-pack {{ key }} --flavor rulebook
#
# Each rule says: "when a document says X, that is out of date, and here is why."
# The verdict comes from the rule, never from an LLM (TRUST rule 1) — the LLM's
# only later role is wording the redline prose around a verdict decided here.
#
# Editing this file re-scans every document: the pack hashes these rules as its
# evidence snapshot, so a new rule is picked up on the next sweep.
#
# Delete the example below and add your own, then set `enabled: true` in
# args/docmod/packs/{{ key }}.yaml.

rules:
  # - id: example-obsolete-term
  #   # Regex matched against document text. (?i) = case-insensitive.
  #   # Anchor with \b so 'FOO' does not match inside 'FOOBAR'.
  #   pattern: '(?i)\bexample obsolete term\b'
  #
  #   # Optional — defaults come from the pack YAML.
  #   entity_type: {{ entity_type }}
  #   verdict: deprecated          # current | deprecated | eol | retired | divergent | unknown
  #   finding_type: {{ finding_type }}
  #   severity: medium             # critical | high | medium | low | info
  #
  #   # Shown to the reviewer as the reason. Cite the authority that makes this
  #   # true (an RFC, a policy number, a vendor bulletin) — this text becomes the
  #   # finding's rationale and lands in front of a human.
  #   rationale: Superseded by <successor> per <authority>.
  #
  #   # Optional. MUST be a real successor — it is offered as the replacement in
  #   # a redline, so an invented one would put fiction into a document.
  #   replacement: <the successor>
