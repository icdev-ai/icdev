# CUI // SP-CTI
# {{ display_name }} — document currency pack (rulebook-driven).
# Generated by: icdev scaffold docmod-pack {{ key }} --flavor rulebook
#
# No Python required: the shared RulebookPack evaluator reads the rules file
# below. Write rules in args/docmod/rulebook_{{ key }}.yaml and this pack starts
# finding things on the next docmod sweep.

pack_id: {{ key }}
label: {{ display_name }}

# Left DISABLED on purpose: an empty rulebook would add a pack to every scan
# that can never find anything. Flip to true once you have written a rule.
enabled: false

evaluator: tools.doc_modernization.packs.rulebook_pack.RulebookPack
entity_types: [{{ entity_type }}]

# Rules file — the pack's only evidence source.
rulebook_path: args/docmod/rulebook_{{ key }}.yaml

# Defaults for rules that omit these. finding_type MUST be listed in
# tools/doc_modernization/constants.py FINDING_TYPES.
default_verdict: deprecated
default_finding_type: {{ finding_type }}
default_severity: medium

# NIST controls this domain implicates, passed to the DocDrift bridge for
# control re-mapping. DECLARED, never inferred from finding text. Leave empty
# if unsure — a wrong control mapping in an SSP is worse than none.
nist_controls: []

evidence_sources: [rulebook_{{ key }}]
