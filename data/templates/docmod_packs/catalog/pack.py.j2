# CUI // SP-CTI
"""{{ display_name }} — document currency pack (catalog-driven).

Generated by: icdev scaffold docmod-pack {{ key }} --flavor catalog

Answers, for this domain: "does what the document says still match {{ evidence_table }}?"

TRUST rule 1 — evaluate() MUST derive its verdict from deterministic evidence
(catalog rows, dates, inventory counts). Never call an LLM here. The LLM's only
role is wording the redline prose around a verdict decided in this file.
"""
from __future__ import annotations

import hashlib

from tools.logging.icdev_logger import get_logger

from ..base_pack import CandidateEntity, ChunkRef, DomainPack, Replacement, Verdict

logger = get_logger(__name__)

EVIDENCE_TABLE = "{{ evidence_table }}"


def _rows(conn, sql: str, params: tuple = ()) -> list[dict]:
    """Query tolerantly and roll back on failure.

    One failed statement poisons the whole PostgreSQL transaction, so every
    optional evidence read must clean up after itself.
    """
    try:
        cur = conn.execute(sql, params)
        return [dict(r) if hasattr(r, "keys") else r for r in cur.fetchall()]
    except Exception as exc:
        logger.warning("{{ key }}: query failed: %s", exc)
        try:
            conn.rollback()
        except Exception:
            pass
        return []


class {{ class_name }}(DomainPack):
    pack_id = "{{ key }}"
    label = "{{ display_name }}"
    entity_types = ["{{ entity_type }}"]

    def extract(self, text: str, chunk_ref: ChunkRef) -> list[CandidateEntity]:
        """Find this domain's entities in the document text.

        Patterns come from config["extraction"]["patterns"] so they are tunable
        without code changes. Consider also matching live vocabulary from
        {{ evidence_table }} as literals — see packs/network_hardware.py, which
        pulls device names out of the inventory rather than guessing by regex.
        """
        import re

        out: list[CandidateEntity] = []
        seen: set[str] = set()
        patterns = ((self.config or {}).get("extraction", {}) or {}).get("patterns", []) or []
        for raw in patterns:
            try:
                pat = re.compile(raw)
            except re.error as exc:
                logger.warning("{{ key }}: bad pattern %r: %s", raw, exc)
                continue
            for m in pat.finditer(text or ""):
                label = (m.group(0) or "").strip()
                if not label or label.lower() in seen:
                    continue
                seen.add(label.lower())
                start = max(0, m.start() - 60)
                out.append(CandidateEntity(
                    label=label,
                    entity_type="{{ entity_type }}",
                    pack_id=self.pack_id,
                    chunk_ref=chunk_ref,
                    raw_match=label,
                    context=(text or "")[start:m.end() + 60].strip(),
                ))
        return out

    def evaluate(self, entity: CandidateEntity, conn) -> Verdict:
        """Decide whether this entity is still current, from {{ evidence_table }}.

        `conn` is the RLS-free evidence connection (get_canvas_connection) —
        evidence tables have no tenant_id/classification, so the RLS predicate
        would raise on every query.

        Return finding_type=None (or currency_verdict='current') for anything
        that is fine — only real problems should reach a human.
        """
        rows = _rows(
            conn,
            f"SELECT * FROM {EVIDENCE_TABLE} WHERE LOWER(name) = %s",  # noqa: S608 - TODO adjust
            (entity.label.lower(),),
        )
        if not rows:
            # Not in the catalog. Decide deliberately: is an unknown item a
            # finding in your domain, or just unknown? Saying 'current' here
            # would claim the document was verified when it was not.
            return Verdict(
                currency_verdict="unknown",
                finding_type=None,
                rationale=f"{entity.label} not found in {EVIDENCE_TABLE}.",
                confidence=0.0,
            )

        row = rows[0]
        # TODO: your domain's real rule, e.g. a status/EOL-date comparison.
        status = str(row.get("status") or "").lower()
        if status in ("deprecated", "retired"):
            return Verdict(
                currency_verdict="deprecated",
                finding_type="{{ 'stale_reference' }}",   # must be in constants.FINDING_TYPES
                severity=str((self.config or {}).get("default_severity", "medium")),
                rationale=f"{entity.label} is {status} per {EVIDENCE_TABLE}.",
                confidence=1.0,
                evidence=[{
                    "source": f"{EVIDENCE_TABLE}:{row.get('id', entity.label)}",
                    "detail": f"status={status}",
                    "date": str(row.get("updated_at") or ""),
                }],
            )

        return Verdict(
            currency_verdict="current",
            finding_type=None,
            rationale=f"{entity.label} is current per {EVIDENCE_TABLE}.",
            confidence=1.0,
        )

    def recommend(self, entity: CandidateEntity, verdict: Verdict, conn) -> Replacement | None:
        """Optional. A Replacement MUST resolve to a real row — never invent a
        successor, it is offered as a redline into a live document."""
        return None

    def evidence_snapshot(self, conn) -> str:
        """Hash this domain's evidence so a catalog change re-scans documents.

        MUST be overridden: the base default hashes static config only, so the
        pack would never re-scan when {{ evidence_table }} changes — the very
        thing it exists to react to.
        """
        rows = _rows(conn, f"SELECT * FROM {EVIDENCE_TABLE}")  # noqa: S608 - TODO narrow columns
        payload = "|".join(str(sorted(r.items())) for r in rows)
        return hashlib.sha256(payload.encode("utf-8")).hexdigest()
