# CUI // SP-CTI
# {{ display_name }} — document currency pack (catalog-driven).
# Generated by: icdev scaffold docmod-pack {{ key }} --flavor catalog

pack_id: {{ key }}
label: {{ display_name }}

# Left DISABLED on purpose: the generated evaluate() is a stub with TODOs and
# would report nonsense until you implement your domain's real rule.
enabled: false

evaluator: tools.doc_modernization.packs.{{ key }}.{{ class_name }}
entity_types: [{{ entity_type }}]

extraction:
  # Regexes matched against document text. Tune to your domain's vocabulary —
  # too broad is noisy, too narrow misses real references.
  patterns: []

default_severity: medium

# NIST controls this domain implicates, passed to the DocDrift bridge for
# control re-mapping. DECLARED, never inferred. Leave empty if unsure — a wrong
# control mapping in an SSP is worse than none.
nist_controls: []

evidence_sources: [{{ evidence_table }}]
