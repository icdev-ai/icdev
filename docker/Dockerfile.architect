# [TEMPLATE: CUI // SP-CTI]
# ICDEV Architect Agent — STIG-Hardened Container
# Controlled by: Department of Defense | CUI Category: CTI | Distribution: D
# Port: 8444 | Tier: Core

FROM python:3.12-slim AS builder

WORKDIR /build
# `git` is a BUILD-time requirement, not a runtime one: requirements.txt carries
# a VCS requirement (`icdev-core @ git+https://...`, xcore-cut-02, 2026-08-26) and
# pip shells out to `git` to resolve it. Without it every build of this image dies
# on `Cannot find command 'git'` before installing a single package.
# It stays in the BUILDER stage, which is discarded, so the runtime stage keeps its
# STIG-minimal package set and gains no new attack surface.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim

LABEL classification="CUI" \
      dissemination_control="SP-CTI" \
      originator="ICDEV" \
      description="ICDEV Architect Agent — ATLAS/M-ATLAS A/T Phases, System Design" \
      port="8444" \
      agent="architect-agent"

# STIG: Create non-root user with explicit UID/GID
RUN groupadd -g 1000 icdev && \
    useradd -u 1000 -g icdev -d /app -s /usr/sbin/nologin icdev

# STIG: Install only required runtime packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/apt-get

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application
WORKDIR /app
COPY --chown=icdev:icdev tools/ tools/
COPY --chown=icdev:icdev args/ args/
COPY --chown=icdev:icdev context/ context/
COPY --chown=icdev:icdev goals/ goals/

# STIG: Set restrictive permissions
# chown is load-bearing, not cleanup: WORKDIR created /app as root and
# COPY --chown only covers the copied CONTENTS, so `chmod -R 750` clears
# the other-bits of a root-owned /app and uid 1000 (icdev) cannot traverse
# it — every `python tools/...` under USER icdev fails with EACCES. The
# image could not run as the non-root user it declares. Verified by
# reproduction; see Dockerfile.dashboard for the full note.
RUN chown -R icdev:icdev /app && \
    chmod -R 750 /app && \
    find /app -type f -name "*.py" -exec chmod 640 {} +

# Data directory for SQLite (mounted as volume in production)
RUN mkdir -p /app/data && chown icdev:icdev /app/data

ENV PYTHONUNBUFFERED=1

# Repo lives at /app but is never pip-installed into the image, so
# `python tools/<x>.py` leaves sys.path[0] at /app/tools/<dir> and every
# `from tools.y import z` raises ModuleNotFoundError — including from each
# image's own default CMD. Matches Dockerfile.alpine.base.
ENV PYTHONPATH=/app

# STIG: Run as non-root
USER icdev

EXPOSE 8444

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8444/health || exit 1

ENTRYPOINT ["python", "tools/a2a/agent_entrypoint.py", "--agent-id", "architect-agent", "--port", "8444", "--no-tls"]
