# [TEMPLATE: CUI // SP-CTI]
# ICDEV Web Dashboard — STIG-Hardened
# Controlled by: Department of Defense | CUI Category: CTI | Distribution: D

FROM python:3.12-slim AS builder

WORKDIR /build
# `git` is a BUILD-time requirement, not a runtime one: requirements.txt carries
# a VCS requirement (`icdev-core @ git+https://...`, xcore-cut-02, 2026-08-26) and
# pip shells out to `git` to resolve it. Without it every build of this image dies
# on `Cannot find command 'git'` before installing a single package.
# It stays in the BUILDER stage, which is discarded, so the runtime stage keeps its
# STIG-minimal package set and gains no new attack surface.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim

LABEL classification="CUI" \
      dissemination_control="SP-CTI" \
      originator="ICDEV" \
      description="ICDEV Web Dashboard"

# STIG: Create non-root user with explicit UID/GID
RUN groupadd -g 1000 icdev && \
    useradd -u 1000 -g icdev -d /app -s /usr/sbin/nologin icdev

# STIG: Install only required runtime packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/apt-get

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application
WORKDIR /app
COPY --chown=icdev:icdev . .

# STIG: Set restrictive permissions
#
# The chown is load-bearing, not cleanup. `WORKDIR /app` creates /app owned by
# root, and `COPY --chown` above only sets ownership on the copied CONTENTS —
# never on /app itself. `chmod -R 750` then clears the other-bits of a
# root-owned directory, so uid 1000 (icdev) matches neither owner nor group and
# cannot traverse /app at all. Every `python tools/...` under USER icdev died
# with:
#     can't open file '/app/tools/db/init_icdev_db.py': [Errno 13] Permission denied
# i.e. this image could not run as the non-root user it declares. It went
# unnoticed because the CI smoke test only runs `python --version` / `echo`,
# neither of which reads /app.
RUN chown -R icdev:icdev /app && \
    chmod -R 750 /app && \
    find /app -type f -name "*.py" -exec chmod 640 {} +

# Data directory for SQLite (mounted as volume in production)
RUN mkdir -p /app/data && chown icdev:icdev /app/data

# Runtime scratch dir — overlaid by tmpfs in production compose;
# created here so bare 'docker run' without --tmpfs also works.
RUN mkdir -p /app/.tmp/genesis && chown -R icdev:icdev /app/.tmp

ENV PYTHONUNBUFFERED=1

# Repo lives at /app but is never pip-installed into the image, so
# `python tools/<x>.py` leaves sys.path[0] at /app/tools/<dir> and every
# `from tools.y import z` raises ModuleNotFoundError — including from each
# image's own default CMD. Matches Dockerfile.alpine.base.
ENV PYTHONPATH=/app

# STIG: Run as non-root
USER icdev

# /health is not a route on this app — it served 404, so every container built
# from this image reported `unhealthy` forever, which also fails
# `docker compose up --wait`. /api/health is reachable without credentials
# because it is in dashboard auth's PUBLIC_ENDPOINTS (added alongside this
# change) — as a load-balancer probe must be.
#
# LIVENESS only: /api/health returns 200 regardless of its internal DB check,
# which is reported in the body as {"status", "db"}. A healthy container means
# the app is serving; it does NOT mean the database is reachable.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:5000/api/health || exit 1

EXPOSE 5000

CMD ["python", "tools/dashboard/app.py", "--port", "5000"]
